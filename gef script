local toastId = 0
local function notify(msg)
	toastId += 1
	local id = toastId
	toast.Text = msg
	tween(toast, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.15)
	task.delay(2.6, function()
		if alive and toastId == id then
			tween(toast, { BackgroundTransparency = 1, TextTransparency = 1 }, 0.3)
		end
	end)

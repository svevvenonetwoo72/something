local function describe(rec)
	local types = {}
	for i = 1, rec.args.n do types[i] = typeof(rec.args[i]) end
	return rec.remote.Name .. "(" .. table.concat(types, ", ") .. ")"
end

local function groundY(pos)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { player.Character }
	local hit = Workspace:Raycast(pos, Vector3.new(0, -40, 0), rp)
	return hit and hit.Position.Y or (pos.Y - 3)
end

local function analyse(rec, c)
	local cf, size = c.cf, c.size
	local axes = { cf.RightVector, cf.UpVector, cf.LookVector }
	local sizes = { size.X, size.Y, size.Z }
	local vi, vbest = 2, -1
	for i = 1, 3 do
		local d = math.abs(axes[i].Y)
		if d > vbest then
			vbest = d
			vi = i
		end
	end
	local hi = {}
	for i = 1, 3 do
		if i ~= vi then table.insert(hi, i) end
	end
	local wi, ti = hi[1], hi[2]
	if sizes[ti] > sizes[wi] then wi, ti = ti, wi end
	local wAxis = Vector3.new(axes[wi].X, 0, axes[wi].Z)
	if wAxis.Magnitude < 0.1 then return false end
	rec.w0 = wAxis.Unit
	rec.width, rec.height, rec.thick = sizes[wi], sizes[vi], sizes[ti]
	return true
end

local function detectPiece(rec)
	local refPos
	for i = 1, rec.args.n do
		local v = rec.args[i]
		local ty = typeof(v)
		if ty == "CFrame" then
			rec.argIndex, rec.argType, refPos = i, "CFrame", v.Position
			rec.baseRot = v - v.Position
			break
		elseif ty == "Vector3" then
			rec.argIndex, rec.argType, refPos = i, "Vector3", v
			break
		end
	end
	if not refPos then return end

	local root = getRoot()
	local gl = groundY(Vector3.new(refPos.X, root and root.Position.Y or (refPos.Y + 3), refPos.Z))
	rec.yOff = refPos.Y - gl
	if rec.yOff < -1 or rec.yOff > 12 then rec.yOff = cfg.height / 2 end

	local seenInst = {}
	local conn = Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") or inst:IsA("BasePart") then table.insert(seenInst, inst) end
	end)
	task.delay(1.6, function()
		conn:Disconnect()
		if not alive then return end
		local cands = {}
		for _, inst in ipairs(seenInst) do
			if inst.Parent then
				local cf, size
				if inst:IsA("Model") then
					local ok1, sz = pcall(function() return inst:GetExtentsSize() end)
					local ok2, pv = pcall(function() return inst:GetPivot() end)
					if ok1 and ok2 then size, cf = sz, pv end
				elseif not inst:FindFirstAncestorOfClass("Model") then
					size, cf = inst.Size, inst.CFrame
				end
				if cf and size and size.Magnitude >= 0.5 and size.Magnitude <= 60
					and not Players:GetPlayerFromCharacter(inst) and not inCharacter(inst) then
					local d = (cf.Position - refPos).Magnitude
					if d <= 20 then table.insert(cands, { cf = cf, size = size, d = d }) end
				end
			end
		end
		if #cands == 0 then
			setStatus("learned: " .. describe(rec) .. ". piece not detected. set size by hand, try the rotate toggle.")
			return
		end
		table.sort(cands, function(a, b) return a.d < b.d end)
		local pick
		for _, c in ipairs(cands) do
			if c.d <= cands[1].d + 1 and (not pick or c.size.Magnitude > pick.size.Magnitude) then pick = c end
		end
		if pick and analyse(rec, pick) then
			setWidth(math.clamp(r2(rec.width), 1, 24))
			setHeight(math.clamp(r2(rec.height), 1, 24))
			setStatus(string.format("learned: %s. piece %.1f wide, %.1f tall, %.1f thick.", describe(rec), rec.width, rec.height, rec.thick))
		else
			setStatus("learned: " .. describe(rec) .. ". piece axes unclear. set size by hand.")
		end
	end)
end

local function commit(rec)

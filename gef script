local JINGLE_URL = "https://github.com/svevvenonetwoo72/something/raw/refs/heads/main/weird-route-jingle.mp3"
local DATA_DIR = "milk_gef"
local jingle = { sound = nil, ready = false, failed = false }
local introGui

local function loadJingle()
	local ok = pcall(function()
		if not (writefile and getcustomasset) then error("no file api") end
		if makefolder and isfolder and not isfolder(DATA_DIR) then makefolder(DATA_DIR) end
		local path = DATA_DIR .. "/weird-route-jingle.mp3"
		local have = false
		if isfile and isfile(path) then
			local okr, data = pcall(readfile, path)
			have = okr and type(data) == "string" and #data > 1000
		end
		if not have then
			local body
			if request then
				local okq, res = pcall(request, { Url = JINGLE_URL, Method = "GET" })
				if okq and res and res.StatusCode == 200 then body = res.Body end
			end
			if not body or #body < 1000 then
				local okh, b = pcall(function() return game:HttpGet(JINGLE_URL) end)
				if okh then body = b end
			end
			if type(body) ~= "string" or #body < 1000 then error("download failed") end
			writefile(path, body)
		end
		local sound = Instance.new("Sound")
		sound.Name = "MilkGefJingle"
		sound.SoundId = getcustomasset(path)
		sound.Volume = 0.8
		sound.Parent = cr(game:GetService("SoundService"))
		jingle.sound = sound
	end)
	jingle.failed = not ok
	jingle.ready = true
end

local function playJingle()
	local s = jingle.sound
	if not s then
		if jingle.failed then notify("jingle failed to load") end
		return
	end
	local t = tick()
	while alive and not s.IsLoaded and tick() - t < 3 do task.wait() end
	if alive then s:Play() end
end

local function introSkipped()
	if env.MilkGefSkipIntro then return true end
	return isfile ~= nil and isfile(DATA_DIR .. "/skip_intro")
end

local function setIntroSkip(skip)
	env.MilkGefSkipIntro = skip or nil
	pcall(function()
		if skip then
			if makefolder and isfolder and not isfolder(DATA_DIR) then makefolder(DATA_DIR) end
			writefile(DATA_DIR .. "/skip_intro", "1")
		elseif isfile and isfile(DATA_DIR .. "/skip_intro") and delfile then
			delfile(DATA_DIR .. "/skip_intro")
		end
	end)
end


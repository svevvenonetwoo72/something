local function serverHop()
	local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local ok, body = pcall(function()
		if request then
			return request({ Url = url, Method = "GET" }).Body
		end
		return game:HttpGet(url)
	end)
	if not ok then notify("server list failed") return end
	local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok2 or not data.data then notify("bad server list") return end
	for _, s in ipairs(data.data) do
		if s.id ~= game.JobId and s.playing < s.maxPlayers then
			notify("hopping...")
			pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, player) end)
			return
		end
	end
	notify("no other server found")
end


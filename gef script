local function pieceRot(tpl, tangent, dir)
	if tpl.w0 and tpl.baseRot then
		local a0 = math.atan2(tpl.w0.X, tpl.w0.Z)
		local a1 = math.atan2(tangent.X, tangent.Z)
		return CFrame.Angles(0, a1 - a0, 0) * tpl.baseRot
	end
	local rot = CFrame.lookAt(Vector3.zero, dir)
	if cfg.rotate then rot = rot * CFrame.Angles(0, math.rad(90), 0) end
	return rot
end

local function blueprint(center, ground, tpl)
	local out = {}
	local r, w, h = cfg.radius, cfg.width, cfg.height
	local t = tpl.thick or 1
	local layers = math.max(1, math.ceil(cfg.wallHeight / h))
	local doorLayers = math.max(1, math.ceil(7 / h))
	local y0 = ground + (tpl.yOff or (h / 2))
	local dirs = { Vector3.new(0, 0, 1), Vector3.new(1, 0, 0), Vector3.new(0, 0, -1), Vector3.new(-1, 0, 0) }

	local cam = Workspace.CurrentCamera
	local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, 1)
	local flat = Vector3.new(look.X, 0, look.Z)
	local doorSide, best = 1, -math.huge
	for i, d in ipairs(dirs) do
		local dot = d:Dot(flat)
		if dot > best then
			best = dot
			doorSide = i
		end
	end

	for layer = 1, layers do
		local y = y0 + (layer - 1) * h
		for si, dir in ipairs(dirs) do
			local span = (dir.Z ~= 0) and r or (r - t / 2)
			local tangent = Vector3.new(-dir.Z, 0, dir.X)
			local n = math.max(1, math.ceil((2 * span) / w))
			local segW = (2 * span) / n
			local doorSegs = math.min(n, math.max(1, math.ceil(4 / segW)))
			local first = math.max(1, math.floor((n - doorSegs) / 2) + 1)
			for k = 1, n do
				local inDoor = cfg.door and si == doorSide and layer <= doorLayers and k >= first and k < first + doorSegs
				if not inDoor then
					local off = -span + (k - 0.5) * segW
					local pos = Vector3.new(center.X, y, center.Z) + dir * r + tangent * off
					table.insert(out, { pos = pos, tangent = tangent, dir = dir })
				end
			end
		end
	end
	return out
end

local function firePiece(tpl, spec)
	local remote = tpl.remote
	if not remote or not remote.Parent then return false end
	local args = table.pack(table.unpack(tpl.args, 1, tpl.args.n))
	local idx = tpl.argIndex
	if idx then
		if tpl.argType == "CFrame" then
			args[idx] = CFrame.new(spec.pos) * pieceRot(tpl, spec.tangent, spec.dir)
		else
			args[idx] = spec.pos
		end
	end
	if tpl.method == "InvokeServer" then
		task.spawn(function() pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n)) end)
	else
		pcall(remote.FireServer, remote, table.unpack(args, 1, args.n))
	end
	return true
end

local function buildHouse(radius)
	if state.building then return end
	local tpl = state.template
	if not tpl then notify("learn the hammer first") return end
	if not tpl.argIndex then notify("template has no position arg, relearn") return end
	local root = getRoot()
	if not root then notify("no character") return end
	if radius then
		cfg.radius = radius
		setRadius(radius)
	end
	state.building = true
	equipHammer()
	root = getRoot()
	if not root then
		state.building = false
		return
	end
	local center = root.Position
	local pieces = blueprint(center, groundY(center), tpl)
	for i, spec in ipairs(pieces) do
		if not state.building or not alive then break end
		if not firePiece(tpl, spec) then
			notify("remote vanished, relearn")
			break
		end
		setStatus("building " .. i .. "/" .. #pieces)
		task.wait(cfg.delay)
	end
	state.building = false
	setStatus("learned: " .. describe(tpl))
	notify("box pass done")
end


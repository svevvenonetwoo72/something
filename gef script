local function espFor(key, adornee, color, hlTarget)
	local o = espObjs[key]
	if o then
		if o.gui.Adornee ~= adornee then o.gui.Adornee = adornee end
		o.seen = true
		return o
	end
	o = { seen = true }
	o.gui = create("BillboardGui", {
		Adornee = adornee, AlwaysOnTop = true, Size = UDim2.fromOffset(160, 34),
		StudsOffset = Vector3.new(0, 2.5, 0), LightInfluence = 0,
	}, espFolder)
	o.label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", TextColor3 = color,
		TextStrokeTransparency = 0.35, Font = Enum.Font.GothamBold, TextSize = 13,
	}, o.gui)
	if hlTarget then
		o.hl = create("Highlight", {
			Adornee = hlTarget, FillColor = color, FillTransparency = 0.82, OutlineColor = color,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, espFolder)
	end
	espObjs[key] = o
	return o
end

local function espUpdate()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local camPos = cam.CFrame.Position
	for _, o in pairs(espObjs) do o.seen = false end

	local function show(key, part, name, color, hlTarget)
		if not part or not part.Parent then return end
		local pos = part:IsA("Attachment") and part.WorldPosition or part.Position
		local d = (pos - camPos).Magnitude
		if d > cfg.espDist then return end
		local o = espFor(key, part, color, hlTarget)
		o.label.Text = name .. "\n" .. math.floor(d) .. "m"
	end

	if cfg.espPlayers then
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			if p ~= player and c then
				show(c, c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart, p.DisplayName, COL_PLAYER, c)
			end
		end
	end

	if cfg.espEnemies then
		for m in pairs(enemies) do
			if m.Parent then
				local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
				show(m, part, m.Name, COL_ENEMY, m)
			end
		end
	end

	if cfg.espItems then
		local f = string.lower(cfg.filter)
		local list = {}
		for inst, e in pairs(items) do
			if inst.Parent and (f == "" or string.find(string.lower(e.label), f, 1, true))
				and (e.kind == "tool" or not ignoredBy(inst, e.label)) then
				local part = partOf(inst)
				if part then
					local pos = part:IsA("Attachment") and part.WorldPosition or part.Position
					local d = (pos - camPos).Magnitude
					if d <= cfg.espDist then
						table.insert(list, { inst = inst, part = part, label = e.label, d = d })
					end
				end
			end
		end
		table.sort(list, function(a, b) return a.d < b.d end)
		for i = 1, math.min(#list, 40) do
			local a = list[i]
			show(a.inst, a.part, a.label, COL_ITEM, nil)
		end
	end

	for key, o in pairs(espObjs) do
		if not o.seen then
			pcall(function() o.gui:Destroy() end)
			if o.hl then pcall(function() o.hl:Destroy() end) end
			espObjs[key] = nil
		end
	end
end


local function setFullbright(on)
	if on then
		if not lightSaved then
			lightSaved = {}
			for _, k in ipairs({ "Brightness", "ClockTime", "FogStart", "FogEnd", "GlobalShadows", "Ambient", "OutdoorAmbient" }) do
				lightSaved[k] = Lighting[k]
			end
			local atm = Lighting:FindFirstChildOfClass("Atmosphere")
			if atm then lightSaved.atm = { Density = atm.Density, Haze = atm.Haze } end
		end
	elseif lightSaved then
		for k, v in pairs(lightSaved) do
			if k ~= "atm" then pcall(function() Lighting[k] = v end) end
		end
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm and lightSaved.atm then
			atm.Density = lightSaved.atm.Density
			atm.Haze = lightSaved.atm.Haze
		end
		lightSaved = nil
	end
	misc.fullbright = on
end

local function restoreCollision()
	local c = player.Character
	if not c then return end
	for _, n in ipairs({ "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
		local p = c:FindFirstChild(n)
		if p and p:IsA("BasePart") then p.CanCollide = true end
	end
end

track(RunService.Heartbeat:Connect(function(dt)
	if misc.fullbright then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogStart = 0
		Lighting.FogEnd = 1e6
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(178, 178, 178)
		Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then
			atm.Density = 0
			atm.Haze = 0
		end
	end
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	if misc.speed and not misc.fly and hum.MoveDirection.Magnitude > 0 then
		root.CFrame = root.CFrame + hum.MoveDirection * misc.speedVal * dt
	end
	if misc.fly and not UIS:GetFocusedTextBox() then
		local cam = Workspace.CurrentCamera
		local cf = cam.CFrame
		local v = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then v += cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then v -= cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then v += cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then v -= cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then v += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v -= Vector3.yAxis end
		root.AssemblyLinearVelocity = v.Magnitude > 0 and v.Unit * misc.flySpeed or Vector3.zero
	end
end))


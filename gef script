local items, enemies, scanned, dirty, scanToken = {}, {}, false, true, 0

local function posOf(inst)
	local cur = inst
	if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then cur = inst.Parent end
	if not cur then return nil end
	if cur:IsA("BasePart") then return cur.Position end
	if cur:IsA("Attachment") then return cur.WorldPosition end
	if cur:IsA("Model") then
		local ok, cf = pcall(function() return cur:GetPivot() end)
		if ok then return cf.Position end
	end
	local p = cur:FindFirstChildWhichIsA("BasePart", true)
	return p and p.Position
end

local function inCharacter(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if Players:GetPlayerFromCharacter(m) then return true end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function labelFor(inst)
	if inst:IsA("ProximityPrompt") then
		local model = inst:FindFirstAncestorOfClass("Model")
		local base = (inst.ObjectText ~= "" and inst.ObjectText) or (model and model.Name) or (inst.Parent and inst.Parent.Name) or "prompt"
		if inst.ActionText ~= "" then return base .. " - " .. inst.ActionText end
		return base
	elseif inst:IsA("ClickDetector") then
		return (inst.Parent and inst.Parent.Name or "click") .. " - click"
	end
	return inst.Name
end

local function ignoredBy(inst, label)
	if not cfg.hideJunk or cfg.ignore == "" then return false end
	local hay = string.lower(label)
	local par = inst.Parent
	local depth = 0
	while par and par ~= Workspace and depth < 3 do
		hay = hay .. " " .. string.lower(par.Name)
		par = par.Parent
		depth += 1
	end
	for word in string.gmatch(string.lower(cfg.ignore), "[^,%s]+") do
		if string.find(hay, word, 1, true) then return true end
	end
	return false
end

local function partOf(inst)
	local cur = inst
	if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then cur = inst.Parent end
	if not cur then return nil end
	if cur:IsA("BasePart") or cur:IsA("Attachment") then return cur end
	if cur:IsA("Tool") then
		return cur:FindFirstChild("Handle") or cur:FindFirstChildWhichIsA("BasePart", true)
	end
	if cur:IsA("Model") then return cur.PrimaryPart or cur:FindFirstChildWhichIsA("BasePart", true) end
	return cur:FindFirstChildWhichIsA("BasePart", true)
end

local function consider(inst)
	if not alive or items[inst] or not inst.Parent then return end
	if inst:IsA("Humanoid") then
		local m = inst.Parent
		if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then enemies[m] = true end
		return
	end
	local pat = string.lower(cfg.enemyPattern)
	if pat ~= "" and inst:IsA("Model") and string.find(string.lower(inst.Name), pat, 1, true)
		and not Players:GetPlayerFromCharacter(inst) then
		enemies[inst] = true
		return
	end
	local kind
	if inst:IsA("ProximityPrompt") then kind = "prompt"
	elseif inst:IsA("ClickDetector") then kind = "click"
	elseif inst:IsA("Tool") then kind = "tool"
	else return end
	if inCharacter(inst) then return end
	local label = labelFor(inst)
	items[inst] = { kind = kind, label = label }
	dirty = true
	if scanned and cfg.filter ~= "" and string.find(string.lower(label), string.lower(cfg.filter), 1, true)
		and (kind == "tool" or not ignoredBy(inst, label)) then
		notify("found: " .. label)
	end
end

local function fullScan()
	scanToken += 1
	local token = scanToken
	scanned = false
	items = {}
	enemies = {}
	local all = Workspace:GetDescendants()
	for i, inst in ipairs(all) do
		if not alive or token ~= scanToken then return end
		consider(inst)
		if i % 500 == 0 then task.wait() end
	end
	scanned = true
	dirty = true
	if currentTab == "Items" then renderItems() end
end

local function grab(inst, entry)
	if state.grabbing then return end
	local root = getRoot()
	if not root then notify("no character") return end
	if not inst.Parent then notify("item is gone") return end
	local pos = posOf(inst)
	if not pos then notify("no position for item") return end
	state.grabbing = true
	local origin = root.CFrame
	tp(CFrame.new(pos + Vector3.new(0, 3, 0)))
	task.wait(0.25)
	if entry.kind == "prompt" then
		local hold = inst.HoldDuration
		pcall(function() inst.HoldDuration = 0 end)
		for _ = 1, 3 do
			if fireproximityprompt then pcall(fireproximityprompt, inst) end
			task.wait(0.12)
		end
		pcall(function() inst.HoldDuration = hold end)
	elseif entry.kind == "click" then
		for _ = 1, 2 do
			if fireclickdetector then pcall(fireclickdetector, inst) end
			task.wait(0.12)
		end
	else
		local handle = inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
		if handle and firetouchinterest then
			pcall(firetouchinterest, root, handle, 0)
			task.wait(0.1)
			pcall(firetouchinterest, root, handle, 1)
		end
		task.wait(0.2)
	end
	task.wait(0.3)
	if cfg.returnAfter then tp(origin) end
	local taken = (not inst:IsDescendantOf(Workspace)) or inCharacter(inst)
	notify((taken and "grabbed: " or "tried: ") .. entry.label)
	dirty = true
	state.grabbing = false
end


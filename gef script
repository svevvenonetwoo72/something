local function runIntro(onDone)
	if introSkipped() then
		onDone(true)
		return
	end
	task.spawn(loadJingle)

	local ig = create("ScreenGui", {
		Name = "MilkGEFIntro", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	local okp = pcall(function() ig.Parent = gui.Parent end)
	if not okp or not ig.Parent then ig.Parent = player:WaitForChild("PlayerGui") end
	introGui = ig

	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local ts = math.clamp(math.floor(vp.X / 9), 56, 120)
	local cy = 0.42
	local below = math.floor(ts * 0.62)

	local skipped = false
	local running = true
	local function go() return alive and not skipped end

	local bg = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 6, 9), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 1,
	}, ig)
	local skipBtn = create("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 50,
	}, ig)
	skipBtn.MouseButton1Click:Connect(function() skipped = true end)

	local scan = create("Frame", {
		Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 0, -4), BackgroundColor3 = ACCENT,
		BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = 2,
	}, bg)
	task.spawn(function()
		while running and alive do
			scan.Position = UDim2.new(0, 0, 0, -4)
			TweenService:Create(scan, TweenInfo.new(1.8, Enum.EasingStyle.Linear), { Position = UDim2.new(0, 0, 1, 0) }):Play()
			task.wait(1.8)
		end
	end)

	local function titleLabel(color, z)
		return create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, cy, 0),
			Size = UDim2.fromOffset(ts * 5, math.floor(ts * 1.2)), BackgroundTransparency = 1, Text = "",
			TextColor3 = color, Font = Enum.Font.GothamBlack, TextSize = ts, TextTransparency = 1, ZIndex = z,
		}, bg)
	end
	local ghostR = titleLabel(Color3.fromRGB(255, 60, 90), 3)
	local ghostC = titleLabel(Color3.fromRGB(60, 220, 255), 3)
	local title = titleLabel(ACCENT, 4)

	local line = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, cy, below + 4), Size = UDim2.fromOffset(0, 2),
		BackgroundColor3 = ACCENT, BorderSizePixel = 0, ZIndex = 4,
	}, bg)
	local sub = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, cy, below + 16), Size = UDim2.fromOffset(460, 22),
		BackgroundTransparency = 1, Text = "", TextColor3 = MUTED, Font = Enum.Font.GothamMedium, TextSize = 16, ZIndex = 4,
	}, bg)
	local status = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, cy, below + 58), Size = UDim2.fromOffset(360, 16),
		BackgroundTransparency = 1, Text = "", TextColor3 = MUTED, Font = Enum.Font.Gotham, TextSize = 12,
		TextTransparency = 1, ZIndex = 4,
	}, bg)
	local barBack = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, cy, below + 78), Size = UDim2.fromOffset(360, 4),
		BackgroundColor3 = SURFACE2, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4,
	}, bg)
	corner(barBack, 2)
	local barFill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ACCENT, BorderSizePixel = 0, ZIndex = 5,
	}, barBack)
	corner(barFill, 2)
	local sig = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(300, 16),
		BackgroundTransparency = 1, Text = "made by nexus", TextColor3 = MUTED, Font = Enum.Font.GothamMedium,
		TextSize = 12, TextTransparency = 1, ZIndex = 4,
	}, bg)
	local hint = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -14), Size = UDim2.fromOffset(160, 14),
		BackgroundTransparency = 1, Text = "click to skip", TextColor3 = MUTED, Font = Enum.Font.Gotham,
		TextSize = 11, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4,
	}, bg)

	local function setProgress(p, text)
		status.Text = text
		tween(barFill, { Size = UDim2.new(p, 0, 1, 0) }, 0.35)
	end

	local function glitch(duration)
		local stop = tick() + duration
		while tick() < stop and go() do
			local dx = math.random(3, 10)
			ghostR.Position = UDim2.new(0.5, -dx, cy, math.random(-3, 3))
			ghostC.Position = UDim2.new(0.5, dx, cy, math.random(-3, 3))
			ghostR.TextTransparency = 0.45
			ghostC.TextTransparency = 0.45
			title.Position = UDim2.new(0.5, math.random(-3, 3), cy, math.random(-2, 2))
			task.wait(0.04)
		end
		ghostR.TextTransparency = 1
		ghostC.TextTransparency = 1
		ghostR.Position = UDim2.new(0.5, 0, cy, 0)
		ghostC.Position = UDim2.new(0.5, 0, cy, 0)
		title.Position = UDim2.new(0.5, 0, cy, 0)
	end

	-- fade in
	tween(bg, { BackgroundTransparency = 0 }, 0.4)
	tween(sig, { TextTransparency = 0.2 }, 0.8)
	tween(hint, { TextTransparency = 0.5 }, 0.8)
	task.wait(0.5)

	-- scramble reveal
	local word = "GEF"
	local chars = "#%&@$?!/|<>0123456789"
	local lockAt = { 0.5, 0.8, 1.1 }
	tween(title, { TextTransparency = 0 }, 0.2)
	local t0 = tick()
	while go() and tick() - t0 < 1.4 do
		local el = tick() - t0
		local s = ""
		for i = 1, #word do
			if el >= lockAt[i] then
				s = s .. string.sub(word, i, i)
			else
				local k = math.random(1, #chars)
				s = s .. string.sub(chars, k, k)
			end
		end
		title.Text, ghostR.Text, ghostC.Text = s, s, s
		task.wait(0.04)
	end
	title.Text, ghostR.Text, ghostC.Text = word, word, word

	-- glitch bursts and underline
	if go() then
		tween(line, { Size = UDim2.fromOffset(360, 2) }, 0.5)
		glitch(0.25)
		task.wait(0.15)
		glitch(0.18)
	end

	-- subtitle typewriter
	local subText = "giant evil face // milk"
	if go() then
		for i = 1, #subText do
			if not go() then break end
			sub.Text = string.sub(subText, 1, i)
			task.wait(0.035)
		end
	end
	sub.Text = subText

	-- loading stages tied to real work
	local minEnd = t0 + 4.4
	if go() then
		tween(status, { TextTransparency = 0 }, 0.3)
		tween(barBack, { BackgroundTransparency = 0 }, 0.3)
		setProgress(0.25, "fetching the jingle...")
		local w = tick()
		while go() and not jingle.ready and tick() - w < 6 do task.wait(0.05) end
		setProgress(0.6, "scanning the world...")
		w = tick()
		while go() and not scanned and tick() - w < 4 do task.wait(0.05) end
		setProgress(0.9, "building the ui...")
		task.wait(0.35)
		setProgress(1, "ready")
		while go() and tick() < minEnd do task.wait(0.03) end
		task.wait(0.2)
	end

	running = false
	if not alive then return end

	-- flash out, open the window under it
	local flash = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 60,
	}, ig)
	tween(flash, { BackgroundTransparency = 0 }, 0.12)
	task.wait(0.14)
	bg.Visible = false
	skipBtn.Visible = false
	pcall(onDone, skipped)
	tween(flash, { BackgroundTransparency = 1 }, 0.55)
	task.wait(0.6)
	pcall(function() ig:Destroy() end)
	introGui = nil
end


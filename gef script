renderItems = function()
	for _, c in ipairs(listFrame:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local root = getRoot()
	local origin = root and root.Position or Vector3.zero
	local f = string.lower(cfg.filter)
	local arr = {}
	for inst, e in pairs(items) do
		if inst.Parent and (f == "" or string.find(string.lower(e.label), f, 1, true))
			and (e.kind == "tool" or not ignoredBy(inst, e.label)) then
			local p = posOf(inst)
			if p then table.insert(arr, { inst = inst, e = e, d = (p - origin).Magnitude }) end
		end
	end

	if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
	if not hammerTool() then return end
	state.lastClick = tick()
	state.fallback = nil
	task.delay(0.9, function()
		if state.learning and state.fallback then commit(state.fallback) end
	end)
end))

local function blueprint(center, ground)
	local out = {}
	local r, w, h = cfg.radius, cfg.width, cfg.height
	local n = math.max(1, math.floor((2 * r) / w))
	local dirs = { Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) }
	for layer = 1, cfg.layers do
		local y = ground + (layer - 0.5) * h
		for si, dir in ipairs(dirs) do
			local tangent = Vector3.new(-dir.Z, 0, dir.X)
			for k = 1, n do
				local skip = cfg.door and si == 1 and layer <= 2 and k == math.ceil(n / 2)
				if not skip then
					local off = -r + (k - 0.5) * (2 * r / n)
					local pos = Vector3.new(center.X, y, center.Z) + dir * r + tangent * off
					local cf = CFrame.lookAt(pos, pos + dir)
					if cfg.rotate then cf = cf * CFrame.Angles(0, math.rad(90), 0) end
					table.insert(out, cf)
				end
			end
		end
	end
	if cfg.roof then
		local y = ground + cfg.layers * h + h / 2
		local gx = math.max(1, math.floor((2 * r) / w))
		for ix = 1, gx do
			for iz = 1, gx do
				local ox = -r + (ix - 0.5) * (2 * r / gx)
				local oz = -r + (iz - 0.5) * (2 * r / gx)
				table.insert(out, CFrame.new(center.X + ox, y, center.Z + oz) * CFrame.Angles(math.rad(90), 0, 0))
			end
		end
	end
	return out
end

local function firePiece(tpl, cf)
	local remote = tpl.remote
	if not remote or not remote.Parent then return false end
	local args = table.pack(table.unpack(tpl.args, 1, tpl.args.n))
	local replaced = false
	for i = 1, args.n do
		local ty = typeof(args[i])
		if not replaced and ty == "CFrame" then
			args[i] = cf
			replaced = true
		elseif not replaced and ty == "Vector3" then
			args[i] = cf.Position
			replaced = true
		end
	end
	if tpl.method == "InvokeServer" then
		task.spawn(function() pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n)) end)
	else
		pcall(remote.FireServer, remote, table.unpack(args, 1, args.n))
	end
	return true
end

local function buildHouse()
	if state.building then return end
	local tpl = state.template
	if not tpl then notify("learn the hammer first") return end
	local root = getRoot()
	if not root then notify("no character") return end
	state.building = true
	equipHammer()
	local center = root.Position
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { player.Character }
	local hit = Workspace:Raycast(center, Vector3.new(0, -30, 0), rp)
	local ground = hit and hit.Position.Y or (center.Y - 3)
	local pieces = blueprint(center, ground)
	for i, cf in ipairs(pieces) do
		if not state.building or not alive then break end
		if not firePiece(tpl, cf) then
			notify("remote vanished, relearn")
			break
		end
		setStatus("building " .. i .. "/" .. #pieces)
		task.wait(cfg.delay)
	end
	state.building = false
	setStatus("learned: " .. describe(tpl))
	notify("house pass done")
end


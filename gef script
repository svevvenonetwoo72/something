		end
	end
	return false
end

local function hasSpatial(packed)
	for i = 1, packed.n do
		local ty = typeof(packed[i])
		if ty == "CFrame" or ty == "Vector3" then return true end
	end
	return false
end

local function describe(rec)
	local types = {}
	for i = 1, rec.args.n do types[i] = typeof(rec.args[i]) end
	return rec.remote.Name .. "(" .. table.concat(types, ", ") .. ")"
end

local function commit(rec)
	if not state.learning then return end
	state.learning = false
	state.fallback = nil
	state.template = rec
	setStatus("learned: " .. describe(rec))
	notify("hammer learned")
end

local bridge = env.MilkGefBridge
if not bridge then
	bridge = {}
	env.MilkGefBridge = bridge
end

if not bridge.hooked and hookmetamethod and getnamecallmethod then
	bridge.hooked = true
	local nc = newcclosure or function(f) return f end
	local old
	old = hookmetamethod(game, "__namecall", nc(function(self, ...)
		local method = getnamecallmethod()
		local cap = bridge.capture
		if cap and (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
			pcall(cap, self, method, ...)
			if setnamecallmethod then setnamecallmethod(method) end
		end
		return old(self, ...)
	end))
end

bridge.capture = function(remote, method, ...)
	if not alive or not state.learning then return end
	if tick() - state.lastClick > 0.9 then return end
	if typeof(remote) ~= "Instance" then return end
	local cn = remote.ClassName
	if cn ~= "RemoteEvent" and cn ~= "RemoteFunction" then return end
	local rec = { remote = remote, method = method, args = table.pack(...) }
	if hasSpatial(rec.args) then
		task.defer(commit, rec)
	elseif not state.fallback then
		state.fallback = rec
	end
end

track(UIS.InputBegan:Connect(function(i, gpe)

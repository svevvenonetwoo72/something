-- remote spy
local spyLog, calls, callId = {}, {}, 0
S.spyIgnore = {}
if hookmetamethod and getnamecallmethod then
	local old
	old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
		local method = getnamecallmethod()
		if S.spy and (method == "FireServer" or method == "InvokeServer")
			and (not checkcaller or not checkcaller()) then
			local args = table.pack(...)
			pcall(function()
				local lname = self.Name:lower()
				for _, k in ipairs(S.spyIgnore) do
					if lname:find(k, 1, true) then return end
				end
				local parts = {}
				for i = 1, args.n do parts[i] = typeof(args[i]) .. ":" .. tostring(args[i]) end
				callId += 1
				calls[#calls + 1] = { id = callId, remote = self, method = method, args = args }
				if #calls > 300 then table.remove(calls, 1) end
				local line = "#" .. callId .. " " .. self:GetFullName() .. " :" .. method .. "(" .. table.concat(parts, ", ") .. ")"
				spyLog[#spyLog + 1] = line
				if #spyLog > 300 then table.remove(spyLog, 1) end
				print("[spy] " .. line)
			end)
		end
		return old(self, ...)
	end))
end

-- helpers
local function teleportTo(pos)
	local hrp = getHRP()
	if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) end
end

local function nearestByKeys(keys)
	local hrp = getHRP()
	if not hrp then return end
	local best, bd = nil, math.huge
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("Model") and not Players:GetPlayerFromCharacter(d) and matches(d.Name, keys) then
			local part = partOf(d)
			if part then
				local dist = (part.Position - hrp.Position).Magnitude
				if dist < bd then best, bd = part, dist end
			end
		end
	end
	return best
end

local function serverHop()
	local okReq, body = pcall(function()
		return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
	end)
	if not okReq then return end
	local data = HttpService:JSONDecode(body)
	for _, s in ipairs(data.data or {}) do
		if s.id ~= game.JobId and s.playing < s.maxPlayers then
			TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, lp)
			return
		end
	end
end


local function bringItems(keys, maxCount)
	local hrp = getHRP()
	if not hrp or #keys == 0 then return 0 end
	local moved = 0
	for _, d in ipairs(Workspace:GetDescendants()) do
		if moved >= maxCount then break end
		if (d:IsA("Model") or d:IsA("BasePart")) and matches(d.Name, keys)
			and not (lp.Character and d:IsDescendantOf(lp.Character))
			and not Players:GetPlayerFromCharacter(d)
			and not d:FindFirstChildOfClass("Humanoid")
			and not d.Name:lower():find("tree", 1, true)
			and not (d:IsA("BasePart") and d.Parent:IsA("Model") and matches(d.Parent.Name, keys)) then
			local part = partOf(d)
			if part and (part.Position - hrp.Position).Magnitude > 6 then
				local target = hrp.CFrame * CFrame.new(math.random(-4, 4), 1, -6 - math.random(0, 3))
				if d:IsA("Model") then d:PivotTo(target) else d.CFrame = target end
				part.AssemblyLinearVelocity = Vector3.zero
				moved += 1
			end
		end
	end
	return moved
end

local function equipByKey(key)
	local char, hum = lp.Character, getHum()
	if not char or not hum then return nil end
	local t = char:FindFirstChildOfClass("Tool")
	if t and t.Name:lower():find(key, 1, true) then return t end
	for _, x in ipairs(lp.Backpack:GetChildren()) do
		if x:IsA("Tool") and x.Name:lower():find(key, 1, true) then
			hum:EquipTool(x)
			return x
		end
	end
	return nil
end


local function replay(id, count, delay)
	local c
	if id then
		for _, x in ipairs(calls) do if x.id == id then c = x break end end
	else
		c = calls[#calls]
	end
	if not c then return false end
	task.spawn(function()
		for _ = 1, count do
			if not alive then break end
			pcall(function()
				if c.method == "FireServer" then
					c.remote:FireServer(table.unpack(c.args, 1, c.args.n))
				else
					c.remote:InvokeServer(table.unpack(c.args, 1, c.args.n))
				end
			end)
			task.wait(delay)
		end
	end)
	return true
end


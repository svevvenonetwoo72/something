	for w in t:lower():gmatch("[^,%s]+") do S.spyIgnore[#S.spyIgnore + 1] = w end
end })
Farm:CreateInput({ Name = "Call # (blank = last)", PlaceholderText = "id from console", RemoveTextAfterFocusLost = false, Callback = function(t) rId = tonumber(t) end })
Farm:CreateSlider({ Name = "Repeat count", Range = { 1, 300 }, Increment = 1, CurrentValue = 20, Callback = function(v) rCount = v end })
Farm:CreateSlider({ Name = "Delay (s)", Range = { 0.01, 1 }, Increment = 0.01, CurrentValue = 0.05, Callback = function(v) rDelay = v end })
Farm:CreateButton({ Name = "Replay call", Callback = function()
	if not replay(rId, rCount, rDelay) then
		Rayfield:Notify({ Title = "Replay", Content = "no captured call. turn spy on first", Duration = 3 })
	end
end })
Farm:CreateButton({ Name = "Clear captured calls", Callback = function() calls = {} spyLog = {} end })

-- cleanup
env.NN_Cleanup = function()
	alive = false
	S.fly, S.noclip, S.spy, S.autoAttack, S.autoPrompt = false, false, false, false, false
	setFullbright(false)
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for inst in pairs(tracked) do clearEsp(inst) end
	pcall(function() espFolder:Destroy() end)
	pcall(function() Rayfield:Destroy() end)
	env.NN_Cleanup = nil
end

Rayfield:Notify({ Title = "99 Nights", Content = "loaded", Duration = 4 })

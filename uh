local function catByName(n) for _, c in ipairs(espCats) do if c.Name == n then return c end end end

local function clearEsp(inst)
	local d = tracked[inst]
	if d then
		pcall(function() d.hl:Destroy() end)
		pcall(function() d.bb:Destroy() end)
		tracked[inst] = nil
	end
end

local function addEsp(inst, cat, label)
	local part = partOf(inst)
	if not part then return end
	local hl
	if cat.Highlight then
		hl = Instance.new("Highlight")
		hl.Adornee = inst
		hl.FillColor = cat.Color
		hl.OutlineColor = cat.Color
		hl.FillTransparency = 0.65
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = espFolder
	end
	local bb = Instance.new("BillboardGui")
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(150, 18)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.Parent = espFolder
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.TextColor3 = cat.Color
	tl.TextStrokeTransparency = 0.4
	tl.Font = Enum.Font.GothamBold
	tl.TextSize = 13
	tl.Parent = bb
	tracked[inst] = { hl = hl, bb = bb, tl = tl, part = part, cat = cat, name = label or inst.Name }
end

local function matches(name, keys)
	name = name:lower()
	for _, k in ipairs(keys) do
		if name:find(k, 1, true) then return true end
	end
	return false
end

loop(4, function()

-- auto attack (uses equipped tool)
local targets = {}
loop(1.2, function()
	if not S.autoAttack then return end
	local list = {}
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("Model") and d ~= lp.Character and not Players:GetPlayerFromCharacter(d) then
			if S.attackMode == "Enemies" then
				local h = d:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then list[#list + 1] = d end
			elseif d.Name:lower():find("tree", 1, true) then
				list[#list + 1] = d
			end
		end
	end
	targets = list
end)

loop(0.15, function()
	if not S.autoAttack then return end
	local hrp, char = getHRP(), lp.Character
	if not hrp or not char then return end
	local best, bestDist = nil, S.attackRange
	for _, m in ipairs(targets) do
		local part = m.Parent and partOf(m)
		if part then
			local dist = (part.Position - hrp.Position).Magnitude
			if dist <= bestDist then best, bestDist = part, dist end
		end
	end
	if not best then return end
	if S.faceTarget then
		hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(best.Position.X, hrp.Position.Y, best.Position.Z))
	end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then tool:Activate() end
end)

-- movement
track(RunService.Heartbeat:Connect(function()
	local hum, hrp = getHum(), getHRP()
	if not hum or not hrp then return end
	if S.speedOn then hum.WalkSpeed = S.speed end
	if S.jumpOn then
		hum.UseJumpPower = true
		hum.JumpPower = S.jump
	end
	if S.fly then
		local cam = Workspace.CurrentCamera
		local move = hum.MoveDirection
		local vy = 0
		if UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then vy = S.flySpeed end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vy = -S.flySpeed end
		if move.Magnitude > 0 and cam then
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.05 then
				vy = vy + look.Y * move:Dot(flat.Unit) * S.flySpeed
			end
		end
		hrp.AssemblyLinearVelocity = Vector3.new(move.X * S.flySpeed, vy, move.Z * S.flySpeed)
	end
end))


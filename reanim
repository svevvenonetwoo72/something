	state.track = t
	setStatus("playing " .. assetId, "good")
end

------------------------------------------------------------------------
-- editor engine: poses, sampling, playback, audio
------------------------------------------------------------------------
local function rad(d) return math.rad(d) end

local EASE = {
	Linear = function(a) return a end,
	Smooth = function(a) return a * a * (3 - 2 * a) end,
	Hold = function() return 0 end,
}
local EASES = { Smooth = true, Linear = true, Hold = true }

local function clean(s, n)
	s = tostring(s or "")
	s = s:gsub("%c", "")
	return s:sub(1, n)
end

-- one keyframe -> a joint transform
local function kfCF(k)
	return CFrame.new(k.px, k.py, k.pz) * CFrame.fromEulerAnglesXYZ(rad(k.rx), rad(k.ry), rad(k.rz))
end

local function sampleTrack(anim, key, t)
	local kfs = anim.tracks[key]
	local n = kfs and #kfs or 0
	if n == 0 then return CFrame.identity end
	if n == 1 or t <= kfs[1].t then return kfCF(kfs[1]) end
	for i = 1, n - 1 do
		local k0, k1 = kfs[i], kfs[i + 1]
		if t >= k0.t and t < k1.t then
			local span = k1.t - k0.t
			local a = span > 0 and (t - k0.t) / span or 1
			return kfCF(k0):Lerp(kfCF(k1), (EASE[k0.ease] or EASE.Smooth)(a))
		end
	end
	local last = kfs[n]
	if anim.loop and anim.length > last.t then
		local a = math.clamp((t - last.t) / (anim.length - last.t), 0, 1)
		return kfCF(last):Lerp(kfCF(kfs[1]), (EASE[last.ease] or EASE.Smooth)(a))
	end
	return kfCF(last)
end

local function sampleAll(anim, t)
	local out = {}
	for _, j in ipairs(JOINT_ORDER) do
		out[j[1]] = sampleTrack(anim, j[1], t)
	end
	return out
end

local function applyTransformsToRig(rig, tbl)
	for _, def in ipairs(R6_JOINTS) do
		local part = rig:FindFirstChild(def[1])
		local m = part and part:FindFirstChild(def[3])
		local tr = tbl[JOINTKEY[def[3]]]
		if m and m:IsA("Motor6D") and tr then m.Transform = tr end
	end
end

local function newTracks()
	return { Root = {}, Neck = {}, LS = {}, RS = {}, LH = {}, RH = {} }
end

local function newAnim()
	return {
		name = "my dance",
		author = LocalPlayer.Name,
		authorId = LocalPlayer.UserId,
		length = 4,
		loop = true,
		tracks = newTracks(),
		events = {},
		sound = { kind = "none", ref = "", volume = 1, offset = 0 },
		version = 2,
	}
end
editor.anim = newAnim()

local function hasKeys(anim)
	for _, j in ipairs(JOINT_ORDER) do
		if #anim.tracks[j[1]] > 0 then return true end
	end
	return false
end

-- validates anything that came from a file, paste or download. data only.
local function sanitizeAnim(raw)
	if type(raw) ~= "table" then return nil, "not an animation" end
	if type(raw.tracks) ~= "table" then return nil, "no tracks (old format?)" end

	local function num(v, lo, hi)
		v = tonumber(v) or 0
		if v ~= v then v = 0 end
		return math.clamp(v, lo, hi)
	end

	local anim = {
		name = clean(raw.name, 40),
		author = clean(raw.author, 30),
		authorId = tonumber(raw.authorId) or 0,
		length = math.clamp(tonumber(raw.length) or 4, 0.2, 60),
		loop = raw.loop == true,
		tracks = newTracks(),
		events = {},
		sound = { kind = "none", ref = "", volume = 1, offset = 0 },
		version = 2,
	}
	if anim.name == "" then anim.name = "untitled" end

	if type(raw.sound) == "table" then
		local kind, ref = raw.sound.kind, tostring(raw.sound.ref or "")
		if kind == "id" then
			local d = ref:match("^%d+$")
			if d and #d <= 20 then anim.sound.kind, anim.sound.ref = "id", d end
		elseif kind == "file" then
			if ref:match("^[%w_%-%. ]+$") and not ref:find("%.%.") and #ref <= 60 then
				anim.sound.kind, anim.sound.ref = "file", ref
			end
		end
		anim.sound.volume = num(raw.sound.volume, 0, 1)
		anim.sound.offset = num(raw.sound.offset, 0, 600)
	end

	for key, list in pairs(anim.tracks) do
		local src = raw.tracks[key]
		if type(src) == "table" then
			for i, k in ipairs(src) do
				if i > 300 then break end
				if type(k) == "table" then
					table.insert(list, {
						t = num(k.t, 0, anim.length),
						ease = EASES[k.ease] and k.ease or "Smooth",
						rx = num(k.rx, -360, 360), ry = num(k.ry, -360, 360), rz = num(k.rz, -360, 360),
						px = num(k.px, -20, 20), py = num(k.py, -20, 20), pz = num(k.pz, -20, 20),
					})
				end
			end
			table.sort(list, function(a, b) return a.t < b.t end)
		end
	end

	if type(raw.events) == "table" then
		for i, e in ipairs(raw.events) do
			if i > 200 then break end
			if type(e) == "table" and FX_KINDS[e.kind] then
				table.insert(anim.events, {
					t = num(e.t, 0, anim.length),
					kind = e.kind,
					col = FX_COLOR_OK[e.col] and e.col or "white",
				})
			end
		end
		table.sort(anim.events, function(a, b) return a.t < b.t end)
	end
	return anim
end

-- audio (client side only: only you hear it)
local audio = { sound = nil }

local function stopSound()
	if audio.sound then
		pcall(function() audio.sound:Stop() end)
		pcall(function() audio.sound:Destroy() end)
		audio.sound = nil
	end
end

local function resolveSoundId(snd)
	if snd.kind == "id" then
		return "rbxassetid://" .. snd.ref
	end
	if snd.kind == "file" then
		local fn = getcustomasset or getsynasset
		if hasFS and fn then
			local path = ROOT .. "/music/" .. snd.ref
			local ok, exists = pcall(isfile, path)
			if ok and exists then
				local ok2, id = pcall(fn, path)
				if ok2 and id then return id end
			end
		end
	end
	return nil
end

local function startSound(anim)
	stopSound()
	local snd = anim.sound
	if not snd or snd.kind == "none" then return end
	local id = resolveSoundId(snd)
	if not id then
		setStatus("sound not found or not allowed", "bad")
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = snd.volume
	s.Looped = false
	s.Parent = gui
	s:Play()
	pcall(function() s.TimePosition = snd.offset end)
	audio.sound = s
end

local function restartSound(anim)
	if audio.sound and anim.sound then
		pcall(function()
			audio.sound.TimePosition = anim.sound.offset
			audio.sound:Play()
		end)
	end
end

local function customApply()
	local rig = state.rig
	if not rig or not state.active then return end
	local c = state.custom
	if c.playing and c.anim then
		applyTransformsToRig(rig, sampleAll(c.anim, c.t))
	elseif editor.live then
		applyTransformsToRig(rig, sampleAll(editor.anim, editor.time))
	end
end

stopCustom = function()
	local c = state.custom
	if not c.playing then return end
	c.playing = false
	c.anim = nil
	stopSound()
	state.locoCur = nil
end

local function startCustom(anim)
	if not state.active or not state.rigHum or not state.rig then
		setStatus("start reanimate first", "bad")
		return
	end
	if state.rigHum.RigType ~= Enum.HumanoidRigType.R6 then
		setStatus("editor playback needs an r6 body (use limb mode)", "bad")
		return
	end
	if not hasKeys(anim) then
		setStatus("add at least one keyframe", "bad")
		return
	end
	stopAnim()
	for _, t in pairs(state.loco) do pcall(function() t:Stop(0.1) end) end
	state.locoCur = nil
	local c = state.custom
	c.anim = anim
	c.t = (anim == editor.anim and editor.time < anim.length - 0.05) and editor.time or 0
	c.speed = cfg.PreviewSpeed
	c.playing = true
	startSound(anim)
	setStatus("playing " .. anim.name, "good")
end

local function customAdvance(dt)
	local c = state.custom
	if not c.playing or not c.anim then return end
	local prev = c.t
	c.t += dt * c.speed
	local len = c.anim.length
	if c.t >= len then
		if fx.fireRange then fx.fireRange(c.anim, prev, len) end
		if c.anim.loop then
			c.t -= len
			restartSound(c.anim)
			if fx.fireRange then fx.fireRange(c.anim, -0.001, c.t) end
		else
			stopCustom()
			setStatus("animation finished", "sub")
			return
		end
	elseif fx.fireRange then
		fx.fireRange(c.anim, prev, c.t)
	end
	if c.anim == editor.anim then
		editor.time = c.t
		if tl.onTime then tl.onTime(true) end
	end
end

local function stopOnMoveCheck()
	if not cfg.StopOnMove or state.fxActive or not state.rigHum then return end
	if state.rigHum.MoveDirection.Magnitude <= 0.1 then return end
	if state.track then stopAnim() end
	if state.custom.playing then
		stopCustom()
		setStatus("stopped (you moved)", "sub")
	end
end

local function updateLoco()
	if state.kind ~= "limb" or not state.rigHum then return end
	if state.track or state.custom.playing then return end
	local hum = state.rigHum
	local want = "idle"
	if hum.FloorMaterial == Enum.Material.Air then
		want = "fall"
	elseif hum.MoveDirection.Magnitude > 0.1 then
		want = "walk"
	end
	if state.locoCur == want then return end
	local old = state.locoCur and state.loco[state.locoCur]
	if old then pcall(function() old:Stop(0.15) end) end
	local new = state.loco[want]
	if new then pcall(function() new:Play(0.15) end) end
	state.locoCur = want
end

local function applyEffects(dt)
	if not state.active then return end
	local rig = state.rig
	local root = rig and rig:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local any = cfg.Spin or cfg.Bob or cfg.Float or cfg.Sway
	if any then
		if not state.fxActive then
			state.fxActive = true
			state.base = root.Position
			local _, yaw = root.CFrame:ToOrientation()
			state.yaw = yaw
			root.Anchored = true
		end
		state.t += dt * cfg.FxSpeed
		if cfg.Spin then state.yaw += dt * cfg.SpinSpeed end
		local y = 0
		if cfg.Float then y += 4 + math.sin(state.t * 1.5) * 0.6 end
		if cfg.Bob then y += math.abs(math.sin(state.t * 6)) * 1.5 end
		local roll = cfg.Sway and math.sin(state.t * 4) * 0.3 or 0
		root.CFrame = CFrame.new(state.base + Vector3.new(0, y, 0))
			* CFrame.Angles(0, state.yaw, 0)
			* CFrame.Angles(0, 0, roll)
	elseif state.fxActive then
		state.fxActive = false
		root.Anchored = false
	end
end

------------------------------------------------------------------------
-- clone mode
------------------------------------------------------------------------
local function buildMap(real, rig)
	local map = {}
	for _, d in ipairs(real:GetChildren()) do
		if d:IsA("BasePart") then
			local c = rig:FindFirstChild(d.Name)
			if c and c:IsA("BasePart") then map[d] = c end
		end
	end
	local realAcc, rigAcc = {}, {}
	for _, c in ipairs(real:GetChildren()) do
		if c:IsA("Accessory") then table.insert(realAcc, c) end
	end
	for _, c in ipairs(rig:GetChildren()) do
		if c:IsA("Accessory") then table.insert(rigAcc, c) end
	end
	for i, acc in ipairs(realAcc) do
		local other = rigAcc[i]
		local h = acc:FindFirstChild("Handle")
		local rh = other and other:FindFirstChild("Handle")
		if h and rh and h:IsA("BasePart") and rh:IsA("BasePart") then map[h] = rh end
	end
	return map
end

local function syncParts()
	local rig = state.rig
	if not rig or not rig.Parent then
		stopClone(true)
		return
	end
	local vel = Vector3.new(0, 25.05, 0)
	for real, target in pairs(state.map) do
		if real.Parent and target.Parent then
			real.CanCollide = false
			real.CFrame = target.CFrame
			real.AssemblyLinearVelocity = vel
			real.AssemblyAngularVelocity = Vector3.zero
		end
	end
	if cfg.NoDrift and not state.fxActive and state.rigHum then
		local puppetRoot = rig:FindFirstChild("HumanoidRootPart")
		if puppetRoot and state.rigHum.MoveDirection.Magnitude < 0.1
			and state.rigHum.FloorMaterial ~= Enum.Material.Air then
			local v = puppetRoot.AssemblyLinearVelocity
			puppetRoot.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
		end
	end
end

applyVisibility = function()
	if state.kind == "limb" then
		local L = state.limb
		if L then
			for _, p in pairs(L.parts) do
				if p.Parent then p.Transparency = (cfg.ShowReal or editor.live) and 0.7 or 1 end
			end
		end
		return
	end
	for real, target in pairs(state.map) do
		if real.Parent then
			real.Transparency = cfg.ShowReal and (state.origReal[real] or 0) or 1
		end
		if target.Parent then
			local o = state.origRig[target] or 0
			target.Transparency = (cfg.ShowReal and o < 1) and 0.75 or o
		end
	end
end

startClone = function()
	if state.active or state.starting then
		setStatus("already running", "sub")
		return
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and hum and root and hum.Health > 0) then
		setStatus("no character found", "bad")
		return
	end

	pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)
	pcall(function() LocalPlayer.MaximumSimulationRadius = math.huge end)

	char.Archivable = true
	local rig = char:Clone()
	if not rig then
		setStatus("clone failed", "bad")
		return
	end
	local rigHum = rig:FindFirstChildOfClass("Humanoid")
	if not rigHum then
		rig:Destroy()
		setStatus("clone has no humanoid", "bad")
		return
	end
	rig.Parent = Workspace
	local map = buildMap(char, rig)

	pcall(function()
		hum.RequiresNeck = false
		hum.BreakJointsOnDeath = false
		hum.PlatformStand = true
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	end)
	pcall(function() hum.EvaluateStateMachine = false end)

	local origReal, origRig = {}, {}
	for _, d in ipairs(rig:GetDescendants()) do
		if d:IsA("BasePart") then origRig[d] = d.Transparency end
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			origReal[d] = d.Transparency
			d.CanCollide = false
			d.Transparency = 1
		end
	end

	state.kind = "clone"
	state.real, state.realHum, state.realRoot = char, hum, root
	state.rig, state.rigHum = rig, rigHum
	state.map = map
	state.origReal, state.origRig = origReal, origRig
	state.fxActive = false
	state.t = 0
	state.active = true
	applyVisibility()

	LocalPlayer.Character = rig
	local camera = Workspace.CurrentCamera
	if camera then camera.CameraSubject = rigHum end

	table.insert(syncConns, RunService.Stepped:Connect(syncParts))
	table.insert(syncConns, PreSim:Connect(customApply))
	table.insert(syncConns, RunService.Heartbeat:Connect(function()
		syncParts()
		stopOnMoveCheck()
	end))
	table.insert(syncConns, RunService.RenderStepped:Connect(function(dt)
		customAdvance(dt)
		customApply()
		applyEffects(dt)
	end))
	table.insert(syncConns, LocalPlayer.CharacterAdded:Connect(function(c)
		if state.active and c ~= state.rig then stopClone(false) end
	end))
	setStatus("clone mode running. pick a dance.", "good")
end

stopClone = function(kill)
	if not state.active or state.kind ~= "clone" then return end
	state.active = false
	for _, c in ipairs(syncConns) do pcall(function() c:Disconnect() end) end
	syncConns = {}
	stopAnim()
	stopCustom()

	local real, realHum, rig = state.real, state.realHum, state.rig
	pcall(function() LocalPlayer.Character = real end)
	pcall(function() if rig then rig:Destroy() end end)
	if kill then
		pcall(function()
			if realHum then
				realHum.EvaluateStateMachine = true
				realHum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				realHum.Health = 0
			end
		end)
		pcall(function() if real then real:BreakJoints() end end)
	end
	state.real, state.realHum, state.realRoot, state.rig, state.rigHum = nil, nil, nil, nil, nil
	state.map = {}
	state.origReal, state.origRig = {}, {}
	state.fxActive = false
	setStatus("stopped. respawning.", "sub")
end


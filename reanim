	for i = 1, ROWS do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.Position = UDim2.fromOffset(0, RULER_H + (i - 1) * ROW_H)
		f.Size = UDim2.fromOffset(300, ROW_H)
		f.ZIndex = 1
		f.Parent = lane
		skin(f, "BackgroundColor3", i % 2 == 0 and "item" or "panel")
		rowBgs[i] = f
	end

	local rulerBg = Instance.new("Frame")
	rulerBg.BorderSizePixel = 0
	rulerBg.Size = UDim2.fromOffset(300, RULER_H)
	rulerBg.ZIndex = 1
	rulerBg.Parent = lane
	skin(rulerBg, "BackgroundColor3", "panel")

	local tickLayer = Instance.new("Frame")
	tickLayer.BackgroundTransparency = 1
	tickLayer.Size = UDim2.fromOffset(300, RULER_H)
	tickLayer.ZIndex = 2
	tickLayer.Parent = lane

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.Size = UDim2.fromOffset(300, tlHeight)
	hit.ZIndex = 2
	hit.Parent = lane

	local keyLayer = Instance.new("Frame")
	keyLayer.BackgroundTransparency = 1
	keyLayer.Active = false
	keyLayer.Size = UDim2.fromOffset(300, tlHeight)
	keyLayer.ZIndex = 3
	keyLayer.Parent = lane

	local playhead = Instance.new("Frame")
	playhead.BorderSizePixel = 0
	playhead.Size = UDim2.fromOffset(2, tlHeight)
	playhead.ZIndex = 5
	playhead.Active = false
	playhead.Parent = lane
	skin(playhead, "BackgroundColor3", "bad")

	local function timeFromX(x)
		local cx = x - lane.AbsolutePosition.X + lane.CanvasPosition.X
		return math.clamp(cx / pps, 0, editor.anim.length)
	end
	local function snapT(t) return math.floor(t * 20 + 0.5) / 20 end
	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	track(hit.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local function scrub(x) ed.setTime(snapT(timeFromX(x))) end
		activeSlider = scrub
		scrub(input.Position.X)
	end))

	local function diamond(x, row, color)
		local d = Instance.new("TextButton")
		d.Size = UDim2.fromOffset(12, 12)
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Position = UDim2.fromOffset(x, RULER_H + (row - 1) * ROW_H + ROW_H / 2)
		d.Rotation = 45
		d.BorderSizePixel = 0
		d.Text = ""
		d.AutoButtonColor = false
		d.BackgroundColor3 = color
		d.ZIndex = 4
		d.Parent = keyLayer
		return d
	end

	function tl.updatePlayhead()
		playhead.Position = UDim2.fromOffset(editor.time * pps - 1, 0)
	end

	function tl.updateReadout()
		local joint = editor.selJoint and JOINT_LABEL[editor.selJoint] or "none"
		local extra = ""
		if editor.selEvent then
			extra = "   event: " .. editor.selEvent.kind .. " (" .. editor.selEvent.col .. ")"
		end
		tl.readout.Text = string.format("time %.2fs of %.1fs   part: %s   tool: %s%s",
			editor.time, editor.anim.length, joint, cfg.Tool, extra)
	end

	function tl.rebuildKeys()
		keyLayer:ClearAllChildren()

		for i, j in ipairs(JOINT_ORDER) do
			local list = editor.anim.tracks[j[1]]
			for _, k in ipairs(list) do
				local selected = editor.selKey ~= nil and editor.selKey.k == k
				local d = diamond(k.t * pps, i, selected and theme.good or theme.accent)
				d.InputBegan:Connect(function(input)
					if not isPress(input) then return end
					editor.selJoint = j[1]
					editor.selKey = { joint = j[1], k = k }
					editor.selEvent = nil
					ed.pushUndo()
					ed.setTime(k.t)
					tl.paintLabels()
					activeSlider = function(x)
						local nt = snapT(timeFromX(x))
						for _, other in ipairs(list) do
							if other ~= k and math.abs(other.t - nt) < 0.02 then return end
						end
						k.t = nt
						table.sort(list, function(a, b) return a.t < b.t end)
						editor.time = nt
						tl.updatePlayhead()
						tl.updateReadout()
						tl.rebuildKeys()
					end
					activeRelease = function() ed.refresh() end
					tl.rebuildKeys()
				end)
			end
		end

		local evs = editor.anim.events
		for _, e in ipairs(evs) do
			local selected = editor.selEvent == e
			local d = diamond(e.t * pps, ROWS, selected and theme.good or EVENT_COLOR)
			d.InputBegan:Connect(function(input)
				if not isPress(input) then return end
				editor.selEvent = e
				editor.selKey = nil
				ed.pushUndo()
				ed.setTime(e.t)
				tl.paintLabels()
				activeSlider = function(x)
					e.t = snapT(timeFromX(x))
					table.sort(evs, function(a, b) return a.t < b.t end)
					editor.time = e.t
					tl.updatePlayhead()
					tl.updateReadout()
					tl.rebuildKeys()
				end
				activeRelease = function() ed.refresh() end
				tl.rebuildKeys()
			end)
		end
	end

	function tl.rebuild()
		local w = lane.AbsoluteSize.X
		if w > 50 then laneW = w end
		local len = math.max(editor.anim.length, 0.5)
		pps = (laneW / len) * cfg.TLZoom
		local canvasW = math.max(laneW, len * pps + 12)
		lane.CanvasSize = UDim2.fromOffset(canvasW, 0)
		for _, f in ipairs(rowBgs) do f.Size = UDim2.fromOffset(canvasW, ROW_H) end
		rulerBg.Size = UDim2.fromOffset(canvasW, RULER_H)
		tickLayer.Size = UDim2.fromOffset(canvasW, RULER_H)
		hit.Size = UDim2.fromOffset(canvasW, tlHeight)
		keyLayer.Size = UDim2.fromOffset(canvasW, tlHeight)

		tickLayer:ClearAllChildren()
		local step = 1
		if pps < 22 then step = 5 elseif pps < 40 then step = 2 end
		for s = 0, math.floor(len), step do
			local tick = Instance.new("Frame")
			tick.BorderSizePixel = 0
			tick.BackgroundColor3 = theme.sub
			tick.Size = UDim2.fromOffset(1, RULER_H - 10)
			tick.Position = UDim2.fromOffset(s * pps, 8)
			tick.ZIndex = 2
			tick.Parent = tickLayer
			local lbl = Instance.new("TextLabel")
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.Gotham
			lbl.TextSize = 10
			lbl.TextColor3 = theme.sub
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.Text = s .. "s"
			lbl.Size = UDim2.fromOffset(30, 10)
			lbl.Position = UDim2.fromOffset(s * pps + 3, 0)
			lbl.ZIndex = 2
			lbl.Parent = tickLayer
		end

		local maxScroll = math.max(0, canvasW - laneW)
		lane.CanvasPosition = Vector2.new(cfg.TLScroll * maxScroll, 0)
		tl.rebuildKeys()
		tl.updatePlayhead()
		tl.updateReadout()
		tl.paintLabels()
	end

	track(lane:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() tl.rebuild() end))
end

-- fine tune sliders for the selected body part
function tl.bindFine()
	local key = editor.selJoint
	for i, ctrl in ipairs(editor.fine) do
		local spec = ctrl.spec
		local visible = false
		if key then
			if i <= 3 then
				visible = true
				local names = { "rotate X", "rotate Y", "rotate Z" }
				spec.text, spec.min, spec.max, spec.dec = names[i], -180, 180, 0
				spec.get = function()
					local x, y, z = ed.currentCF(key):ToEulerAnglesXYZ()
					return math.deg(({ x, y, z })[i])
				end
				spec.set = function(v)
					ed.maybeUndo()
					local cf = ed.currentCF(key)
					local x, y, z = cf:ToEulerAnglesXYZ()
					local e = { math.deg(x), math.deg(y), math.deg(z) }
					e[i] = v
					ed.setKeyCF(key, editor.time,
						CFrame.new(cf.Position) * CFrame.fromEulerAnglesXYZ(rad(e[1]), rad(e[2]), rad(e[3])))
				end
			elseif key == "Root" then
				visible = true
				local j = i - 3
				local labels = { "move right", "move up", "move back" }
				spec.text, spec.min, spec.max, spec.dec = labels[j], -6, 6, 2
				spec.get = function()
					local p = ed.currentCF(key).Position
					return ({ -p.X, p.Z, p.Y })[j]
				end
				spec.set = function(v)
					ed.maybeUndo()
					local cf = ed.currentCF(key)
					local p = cf.Position
					local vals = { -p.X, p.Z, p.Y }
					vals[j] = v
					ed.setKeyCF(key, editor.time,
						CFrame.new(Vector3.new(-vals[1], vals[3], vals[2])) * (cf - cf.Position))
				end
			end
		end
		ctrl.row.Visible = visible
		if visible then ctrl.render() end
	end
end

function tl.onTime(light)
	tl.updatePlayhead()
	tl.updateReadout()
	if not light then tl.bindFine() end
end


minimized = false
track(minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "-"
	if minimized then
		body.Visible = false
	else
		task.delay(0.12, function()
			if not minimized and main.Parent then body.Visible = true end
		end)
	end
	TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
		Size = minimized and COLLAPSED or EXPANDED,
	}):Play()
end))

do
	local dragging = false
	local dragStart
	local startPos

	track(header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		if not isMove then return end
		if activeSlider then
			activeSlider(input.Position.X)
		elseif dragging then
			local delta = input.Position - dragStart
			local screen = gui.AbsoluteSize
			local x = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, screen.X - 120))
			local y = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, screen.Y - 44))
			main.Position = UDim2.fromOffset(x, y)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			activeSlider = nil
			if activeRelease then
				local f = activeRelease
				activeRelease = nil
				f()
			end
		end
	end))
end

cleanup = function()
	stopReanimate(true)
	stopSound()
	pcall(function() RunService:UnbindFromRenderStep("MilkOrbit") end)
	pcall(function()
		local cam = Workspace.CurrentCamera
		if cam and orbitActive then cam.CameraType = Enum.CameraType.Custom end
	end)
	pcall(function() Workspace.FallenPartsDestroyHeight = origFPDH end)
	for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
	connections = {}
	pcall(function() fx.cleanup() end)
	pcall(function() gz.pivot:Destroy() end)
	pcall(function() gui:Destroy() end)
end

env.MilkReanimCleanup = cleanup

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if UserInputService:GetFocusedTextBox() then return end
	local k = input.KeyCode
	if k == Enum.KeyCode.RightShift then
		main.Visible = not main.Visible
	elseif k == Enum.KeyCode.End then
		cleanup()
	elseif cfg.Hotkeys and input.UserInputType == Enum.UserInputType.Keyboard then
		local idx = HOTKEYS[k.Name]
		if idx then
			playEmoteByIndex(idx)
		elseif k == Enum.KeyCode.G then
			stopAnim()
			stopCustom()
		end
	end
end))

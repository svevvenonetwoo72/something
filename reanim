------------------------------------------------------------------------
local function buildPuppet(cf)
	local model = Instance.new("Model")
	model.Name = "MilkPuppet"

	local hum = Instance.new("Humanoid")
	hum.Name = "Humanoid"
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.HipHeight = 0
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.MaxHealth = 100
	hum.Health = 100
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum.Parent = model

	local animator = Instance.new("Animator")
	animator.Parent = hum

	local parts = {}
	for name, size in pairs(PUPPET_DIMS) do
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Transparency = 1
		p.Anchored = false
		p.CanCollide = (name == "HumanoidRootPart")
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = cf * PUPPET_OFFSETS[name]
		p.Parent = model
		parts[name] = p
	end
	for _, def in ipairs(R6_JOINTS) do
		local motor = Instance.new("Motor6D")
		motor.Name = def[3]
		motor.Part0 = parts[def[1]]
		motor.Part1 = parts[def[2]]
		motor.C0 = def[4]
		motor.C1 = def[5]
		motor.Parent = parts[def[1]]
	end
	model.PrimaryPart = parts.HumanoidRootPart
	return model, parts, hum
end

local function setMotorTransform(motor, transform)
	motor.MaxVelocity = 9e9
	local _, _, angle = transform:ToEulerAngles(Enum.RotationOrder.ZYX)
	pcall(function() motor:SetDesiredAngle(angle) end)
	local axis, rot = transform:ToAxisAngle()
	pcall(sethiddenproperty, motor, "ReplicateCurrentOffset6D", transform.Position)
	pcall(sethiddenproperty, motor, "ReplicateCurrentAngle6D", axis * rot)
end

local function setMotorOffset(motor, offset)
	setMotorTransform(motor, motor.C0:Inverse() * offset * motor.C1)
end

local function limbStep()
	local L = state.limb
	local puppet = state.rig
	if not (L and puppet and puppet.Parent) then
		stopLimb(true)
		return
	end
	local char, hum, root = L.char, L.hum, L.root
	if not (char.Parent and hum.Parent and root.Parent) then
		stopLimb(false)
		return
	end

	local pr = L.parts.HumanoidRootPart
	if cfg.ParkMode == "Void" then
		root.CFrame = CFrame.new(L.voidPos)
	else
		root.CFrame = pr.CFrame * CFrame.new(0, -16, 0)
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	hum.AutoRotate = false
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Freefall) end)
	for _, p in ipairs(L.baseParts) do
		if p.Parent then p.CanCollide = false end
	end
	for _, j in ipairs(L.joints) do
		if j.motor.Parent then
			local p0 = j.isRoot and root or L.parts[j.p0]
			local p1 = L.parts[j.p1]
			setMotorOffset(j.motor, p0.CFrame:ToObjectSpace(p1.CFrame))
		end
	end
end

local function frameStep()
	customApply()
	limbStep()
end

startLimb = function()
	if state.active or state.starting then
		setStatus("already running", "sub")
		return
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and hum and root and hum.Health > 0) then
		setStatus("no character found", "bad")
		return
	end
	if hum.RigType ~= Enum.HumanoidRigType.R6 then
		setStatus("limb mode needs an r6 body", "bad")
		return
	end

	state.starting = true
	local spawnCF = root.CFrame
	setStatus("killing body. waiting for respawn...", "sub")

	task.spawn(function()
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
			hum.Health = 0
		end)

		local newChar, newHum, newRoot
		local t0 = os.clock()
		while os.clock() - t0 < 15 do
			local c = LocalPlayer.Character
			if c and c ~= char then
				local h = c:FindFirstChildOfClass("Humanoid")
				local r = c:FindFirstChild("HumanoidRootPart")
				if h and r and c:FindFirstChild("Torso") and h.Health > 0 then
					newChar, newHum, newRoot = c, h, r
					break
				end
			end
			task.wait()
		end
		if not newChar then
			state.starting = false
			setStatus("no respawn. try again.", "bad")
			return
		end
		task.wait(0.2)
		if newHum.RigType ~= Enum.HumanoidRigType.R6 then
			state.starting = false
			setStatus("respawned body is not r6", "bad")
			return
		end

		pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)
		pcall(function() LocalPlayer.MaximumSimulationRadius = math.huge end)

		for _, d in ipairs(newChar:GetDescendants()) do
			if d:IsA("Animator") then d:Destroy() end
		end
		local animate = newChar:FindFirstChild("Animate")
		if animate then animate:Destroy() end

		local joints = {}
		for _, def in ipairs(R6_JOINTS) do
			local parent = newChar:FindFirstChild(def[1])
			local motor = parent and parent:FindFirstChild(def[3])
			if motor and motor:IsA("Motor6D") then
				table.insert(joints, { motor = motor, p0 = def[1], p1 = def[2], isRoot = def[3] == "RootJoint" })
			end
		end
		if #joints < #R6_JOINTS then
			state.starting = false
			setStatus("body is missing joints", "bad")
			return
		end

		local baseParts = {}
		for _, d in ipairs(newChar:GetDescendants()) do
			if d:IsA("BasePart") and not d:FindFirstAncestorWhichIsA("Tool") then
				table.insert(baseParts, d)
			end
		end

		local puppet, parts, puppetHum = buildPuppet(spawnCF)
		puppet.Parent = Workspace

		local voidPos = Vector3.new(
			math.random(-65536, 65536), math.random(-70000, -60000), math.random(-65536, 65536))
		if cfg.ParkMode == "Void" then
			pcall(function() Workspace.FallenPartsDestroyHeight = 0 / 0 end)
		end

		local loco = {}
		local animator = puppetHum:FindFirstChildOfClass("Animator")
		if animator then
			for name, id in pairs(LOCO_IDS) do
				local a = Instance.new("Animation")
				a.AnimationId = "rbxassetid://" .. id
				local ok, t = pcall(function() return animator:LoadAnimation(a) end)
				if ok and t then
					t.Looped = true
					t.Priority = (name == "idle") and Enum.AnimationPriority.Idle
						or Enum.AnimationPriority.Movement
					loco[name] = t
				end
			end
		end

		state.kind = "limb"
		state.real, state.realHum, state.realRoot = newChar, newHum, newRoot
		state.rig, state.rigHum = puppet, puppetHum
		state.limb = {
			char = newChar, hum = newHum, root = newRoot,
			parts = parts, joints = joints, baseParts = baseParts, voidPos = voidPos,
		}
		state.loco = loco
		state.locoCur = nil
		state.fxActive = false
		state.t = 0
		state.active = true
		state.starting = false
		applyVisibility()

		LocalPlayer.Character = puppet
		local camera = Workspace.CurrentCamera
		if camera then camera.CameraSubject = puppetHum end

		table.insert(syncConns, newChar.DescendantAdded:Connect(function(d)
			if d:IsA("Animator") then
				task.defer(function() pcall(function() d:Destroy() end) end)
			end
		end))
		table.insert(syncConns, PreSim:Connect(frameStep))
		table.insert(syncConns, RunService.Heartbeat:Connect(function()
			frameStep()
			stopOnMoveCheck()
			updateLoco()
		end))
		table.insert(syncConns, RunService.RenderStepped:Connect(function(dt)
			customAdvance(dt)
			frameStep()
			applyEffects(dt)
		end))
		table.insert(syncConns, newHum.Died:Connect(function() stopLimb(false) end))
		table.insert(syncConns, LocalPlayer.CharacterAdded:Connect(function(c)
			if state.active and c ~= state.rig then stopLimb(false) end
		end))
		setStatus("limb mode running. pick a dance.", "good")
	end)
end

stopLimb = function(kill)
	if not state.active or state.kind ~= "limb" then return end
	state.active = false
	for _, c in ipairs(syncConns) do pcall(function() c:Disconnect() end) end
	syncConns = {}
	stopAnim()
	stopCustom()
	for _, t in pairs(state.loco) do pcall(function() t:Stop(0) end) end
	state.loco = {}
	state.locoCur = nil

	local L, rig = state.limb, state.rig
	pcall(function() Workspace.FallenPartsDestroyHeight = origFPDH end)
	pcall(function() if L then LocalPlayer.Character = L.char end end)
	pcall(function() if rig then rig:Destroy() end end)
	if kill and L then
		pcall(function() L.hum.Health = 0 end)
		pcall(function() L.char:BreakJoints() end)
	end
	state.real, state.realHum, state.realRoot, state.rig, state.rigHum = nil, nil, nil, nil, nil
	state.limb = nil
	state.fxActive = false
	setStatus("stopped. respawning.", "sub")
end

startReanimate = function()
	if cfg.Mode == "Limb" then startLimb() else startClone() end
end

stopReanimate = function(kill)
	if state.kind == "limb" then stopLimb(kill) else stopClone(kill) end
end

------------------------------------------------------------------------
-- editor actions
------------------------------------------------------------------------
function ed.refresh()
	for _, f in ipairs(editor.refreshers) do pcall(f) end
end

function ed.copyTracks(tracks)
	local out = {}
	for key, list in pairs(tracks) do
		local copy = {}
		for i, k in ipairs(list) do
			copy[i] = { t = k.t, ease = k.ease, rx = k.rx, ry = k.ry, rz = k.rz, px = k.px, py = k.py, pz = k.pz }
		end
		out[key] = copy
	end
	return out
end

function ed.snapshot()
	local events = {}
	for i, e in ipairs(editor.anim.events) do
		events[i] = { t = e.t, kind = e.kind, col = e.col }
	end
	return { tracks = ed.copyTracks(editor.anim.tracks), events = events }
end

function ed.pushUndo()
	table.insert(editor.undo, ed.snapshot())
	if #editor.undo > 40 then table.remove(editor.undo, 1) end
	editor.lastUndo = os.clock()
end

function ed.maybeUndo()
	if os.clock() - editor.lastUndo > 0.8 then ed.pushUndo() end
end

function ed.currentCF(key)
	return sampleTrack(editor.anim, key, editor.time)
end

function ed.getMotor(rig, key)
	local def = DEF_BY_KEY[key]
	if not def or not rig then return nil end
	local part = rig:FindFirstChild(def[1])
	local m = part and part:FindFirstChild(def[3])
	if m and m:IsA("Motor6D") then return m end
	return nil
end

-- writes (or updates) a keyframe on one joint's track at time t
function ed.setKeyCF(key, t, cf)
	local list = editor.anim.tracks[key]
	local created = false
	if #list == 0 and t > 0.001 then
		table.insert(list, { t = 0, ease = cfg.Ease, rx = 0, ry = 0, rz = 0, px = 0, py = 0, pz = 0 })
		created = true
	end
	local rx, ry, rz = cf:ToEulerAnglesXYZ()
	local p = cf.Position
	local target
	for _, k in ipairs(list) do
		if math.abs(k.t - t) < 0.02 then
			target = k
			break
		end
	end
	if not target then
		target = { t = t, ease = cfg.Ease }
		table.insert(list, target)
		table.sort(list, function(a, b) return a.t < b.t end)
		created = true
	end
	target.rx, target.ry, target.rz = math.deg(rx), math.deg(ry), math.deg(rz)
	target.px, target.py, target.pz = p.X, p.Y, p.Z
	editor.selKey = { joint = key, k = target }
	editor.selEvent = nil
	if created and tl.rebuildKeys then tl.rebuildKeys() end
	return target
end

function ed.setTime(t)
	editor.time = math.clamp(t, 0, editor.anim.length)
	if tl.onTime then tl.onTime() end
end

function ed.selectJoint(key)
	editor.selJoint = key
	if editor.selKey and editor.selKey.joint ~= key then editor.selKey = nil end
	if key then editor.selEvent = nil end
	if tl.paintLabels then tl.paintLabels() end
	if tl.rebuildKeys then tl.rebuildKeys() end
	ed.refresh()
end

function ed.jumpKey(dir)
	local times, seen = {}, {}
	for _, j in ipairs(JOINT_ORDER) do
		for _, k in ipairs(editor.anim.tracks[j[1]]) do
			local r = math.floor(k.t * 100 + 0.5)
			if not seen[r] then
				seen[r] = true
				table.insert(times, k.t)
			end
		end
	end
	table.sort(times)
	if #times == 0 then return end
	local cur = editor.time
	if dir > 0 then
		for _, t in ipairs(times) do
			if t > cur + 0.01 then
				ed.setTime(t)
				return
			end
		end
	else
		for i = #times, 1, -1 do
			if times[i] < cur - 0.01 then
				ed.setTime(times[i])
				return
			end
		end
	end
end

function ed.keySelected()
	if not editor.selJoint then
		setStatus("select a body part first", "bad")
		return
	end
	ed.pushUndo()
	ed.setKeyCF(editor.selJoint, editor.time, ed.currentCF(editor.selJoint))
	tl.rebuildKeys()
	ed.refresh()
	setStatus("key set on " .. JOINT_LABEL[editor.selJoint], "good")
end

function ed.keyAll()
	ed.pushUndo()
	local cfs = {}
	for _, j in ipairs(JOINT_ORDER) do cfs[j[1]] = ed.currentCF(j[1]) end
	for _, j in ipairs(JOINT_ORDER) do ed.setKeyCF(j[1], editor.time, cfs[j[1]]) end
	editor.selKey = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("keyed every part at " .. string.format("%.2f", editor.time) .. "s", "good")
end

function ed.addEvent()
	ed.pushUndo()
	local e = { t = editor.time, kind = cfg.FxEvent, col = cfg.FxColor }
	table.insert(editor.anim.events, e)
	table.sort(editor.anim.events, function(a, b) return a.t < b.t end)
	editor.selEvent = e
	editor.selKey = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("fx event added: " .. e.kind, "good")
end

function ed.deleteKey()
	if editor.selEvent then
		ed.pushUndo()
		local i = table.find(editor.anim.events, editor.selEvent)
		if i then table.remove(editor.anim.events, i) end
		editor.selEvent = nil
		tl.rebuildKeys()
		ed.refresh()
		setStatus("event deleted", "sub")
		return
	end
	local s = editor.selKey
	if not s then
		setStatus("select a keyframe or event first", "bad")
		return
	end
	ed.pushUndo()
	local list = editor.anim.tracks[s.joint]
	local i = table.find(list, s.k)
	if i then table.remove(list, i) end
	editor.selKey = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("keyframe deleted", "sub")
end

function ed.clearTrack()
	if not editor.selJoint then
		setStatus("select a body part first", "bad")
		return
	end
	ed.pushUndo()
	editor.anim.tracks[editor.selJoint] = {}
	editor.selKey = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("cleared " .. JOINT_LABEL[editor.selJoint], "sub")
end

function ed.undo()
	local snap = table.remove(editor.undo)
	if not snap then
		setStatus("nothing to undo", "sub")
		return
	end
	editor.anim.tracks = snap.tracks
	editor.anim.events = snap.events
	editor.selKey = nil
	editor.selEvent = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("undone", "sub")
end

-- copy one side to the other. mirrored rotation = same x, negated y and z
function ed.mirror(fromKeys, toKeys)
	ed.pushUndo()
	for i, from in ipairs(fromKeys) do
		local dst = {}
		for _, k in ipairs(editor.anim.tracks[from]) do
			table.insert(dst, { t = k.t, ease = k.ease, rx = k.rx, ry = -k.ry, rz = -k.rz, px = 0, py = 0, pz = 0 })
		end
		editor.anim.tracks[toKeys[i]] = dst
	end
	editor.selKey = nil
	tl.rebuildKeys()
	ed.refresh()
	setStatus("mirrored arms and legs", "sub")
end

local function loadIntoEditor(anim)
	editor.anim = anim
	editor.selKey = nil
	editor.selEvent = nil
	editor.undo = {}
	editor.time = 0
	if tl.rebuild then tl.rebuild() end
	ed.refresh()
end

function ed.listLocal()
	local names = {}
	if hasFS then
		ensureFolders()
		local ok, files = pcall(listfiles, ROOT .. "/anims")
		if ok and type(files) == "table" then
			for _, p in ipairs(files) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then table.insert(names, n) end
			end
		end
	end
	table.sort(names)
	return names
end

local function refreshLocal()
	editor.localNames = ed.listLocal()
	if not table.find(editor.localNames, editor.localSel) then
		editor.localSel = editor.localNames[1]
	end
	ed.refresh()
end

function ed.saveAnim()
	if not hasFS then
		setStatus("this executor has no file functions", "bad")
		return
	end
	ensureFolders()
	local c = sanitizeAnim(editor.anim)
	if not c then
		setStatus("could not save", "bad")
		return
	end
	local name = safeName(c.name)
	local ok = pcall(writefile, ROOT .. "/anims/" .. name .. ".json", HttpService:JSONEncode(c))
	if ok then
		editor.localSel = name
		refreshLocal()
		setStatus("saved " .. name .. ".json", "good")
	else
		setStatus("save failed", "bad")
	end
end

function ed.loadSelected()
	if not hasFS or not editor.localSel then
		setStatus("nothing to load", "bad")
		return
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(ROOT .. "/anims/" .. editor.localSel .. ".json"))
	end)
	local anim = ok and sanitizeAnim(data) or nil
	if not anim then
		setStatus("could not read that file", "bad")
		return
	end
	loadIntoEditor(anim)
	setStatus("loaded " .. anim.name, "good")
end

function ed.deleteSelected()
	if hasFS and editor.localSel and type(delfile) == "function" then
		pcall(delfile, ROOT .. "/anims/" .. editor.localSel .. ".json")
		refreshLocal()
		setStatus("deleted", "sub")
	else
		setStatus("cannot delete here", "bad")
	end
end

function ed.exportJson()
	local c = sanitizeAnim(editor.anim)
	if not c then
		setStatus("could not export", "bad")
		return
	end
	local json = HttpService:JSONEncode(c)
	if setclipboard then
		pcall(setclipboard, json)
		setStatus("json copied. upload it as " .. safeName(c.name) .. ".json", "good")
	else
		setStatus("no clipboard here. use save, then copy the file.", "bad")
	end
end

function ed.copyIndexEntry()
	local c = sanitizeAnim(editor.anim)
	if not c then return end
	local entry = string.format(
		'{ "name": %s, "author": %s, "authorId": %.0f, "desc": "", "file": %s }',
		HttpService:JSONEncode(c.name), HttpService:JSONEncode(c.author),
		c.authorId, HttpService:JSONEncode(safeName(c.name) .. ".json"))
	if setclipboard then
		pcall(setclipboard, entry)
		setStatus("index entry copied. paste it into index.json", "good")
	else
		setStatus("no clipboard here", "bad")
	end
end

function ed.importText(text)
	local ok, data = pcall(function() return HttpService:JSONDecode(text) end)
	local anim, err = nil, nil
	if ok then anim, err = sanitizeAnim(data) end
	if not anim then
		setStatus("import failed: " .. tostring(err or "bad json"), "bad")
		return
	end
	loadIntoEditor(anim)
	setStatus("imported " .. anim.name, "good")
end

------------------------------------------------------------------------
-- gizmo: rotate rings and move arrows on the selected body part
------------------------------------------------------------------------
do
	local GuiService = game:GetService("GuiService")
	pcall(function()
		local old = Workspace:FindFirstChild("MilkPivot")
		if old then old:Destroy() end
	end)

	local pivot = Instance.new("Part")
	pivot.Name = "MilkPivot"
	pivot.Anchored = true
	pivot.CanCollide = false
	pivot.CanQuery = false
	pivot.CanTouch = false
	pivot.Transparency = 1
	pivot.Size = Vector3.new(3, 3, 3)
	pivot.Parent = Workspace
	gz.pivot = pivot

	local arcs = Instance.new("ArcHandles")
	arcs.Color3 = Color3.fromRGB(255, 170, 60)
	arcs.Parent = gui
	local moves = Instance.new("Handles")
	moves.Style = Enum.HandlesStyle.Movement
	moves.Color3 = Color3.fromRGB(90, 200, 255)
	moves.Parent = gui
	local box = Instance.new("SelectionBox")
	box.Color3 = Color3.fromRGB(255, 255, 255)
	box.LineThickness = 0.03
	box.Parent = gui

	local function hide()
		if arcs.Adornee ~= nil then arcs.Adornee = nil end
		if moves.Adornee ~= nil then moves.Adornee = nil end
		if box.Adornee ~= nil then box.Adornee = nil end
	end

	local function step()
		local rig = state.rig
		local key = editor.selJoint
		if not (editor.live and state.active and rig and key and not state.custom.playing) then
			if not gz.busy then hide() end
			return
		end
		local motor = ed.getMotor(rig, key)
		if not (motor and motor.Part1) then
			hide()
			return
		end
		local child = motor.Part1
		local moveMode = cfg.Tool == "move" and key == "Root"
		if not gz.busy then
			if moveMode then
				pivot.Size = Vector3.new(4, 4, 4)
				pivot.CFrame = CFrame.new(child.Position)
			else
				local jw = child.CFrame * motor.C1
				local rot = child.CFrame - child.CFrame.Position
				pivot.Size = key == "Root" and Vector3.new(5, 5, 5) or Vector3.new(3.6, 3.6, 3.6)
				pivot.CFrame = CFrame.new(jw.Position) * rot
			end
		end
		local wantArc = (not moveMode) and pivot or nil
		local wantMove = moveMode and pivot or nil
		if arcs.Adornee ~= wantArc then arcs.Adornee = wantArc end
		if moves.Adornee ~= wantMove then moves.Adornee = wantMove end
		if box.Adornee ~= child then box.Adornee = child end
	end
	track(RunService.RenderStepped:Connect(step))

	local function snapAngle(a)
		if cfg.Snap then
			local s = math.rad(5)
			return math.floor(a / s + 0.5) * s
		end
		return a
	end

	local function beginDrag()
		if gz.busy or not editor.selJoint or not state.rig then return end
		local motor = ed.getMotor(state.rig, editor.selJoint)
		if not motor then return end
		ed.pushUndo()
		gz.busy = true
		gz.key = editor.selJoint
		gz.startCF = ed.currentCF(gz.key)
		gz.frame0 = motor.Part0.CFrame * motor.C0
		gz.c1rot = motor.C1 - motor.C1.Position
	end

	local function endDrag()
		if not gz.busy then return end
		gz.busy = false
		ed.refresh()
	end

	-- rotating the child about its own axes at the joint pivot
	-- becomes  T' = T * (C1rot^-1 * R * C1rot)  in joint space
	local function onRotate(axis, angle)
		if not gz.busy then return end
		angle = snapAngle(cfg.FlipDrag and -angle or angle)
		local r = CFrame.fromAxisAngle(Vector3.FromAxis(axis), angle)
		ed.setKeyCF(gz.key, editor.time, gz.startCF * (gz.c1rot:Inverse() * r * gz.c1rot))
	end

	local function onMove(face, dist)
		if not gz.busy then return end
		dist = math.floor(dist * 20 + 0.5) / 20
		local world = Vector3.FromNormalId(face) * dist
		local d = gz.frame0:VectorToObjectSpace(world)
		local cf = gz.startCF
		ed.setKeyCF(gz.key, editor.time, CFrame.new(cf.Position + d) * (cf - cf.Position))
	end

	track(arcs.MouseButton1Down:Connect(function() beginDrag() end))
	track(arcs.MouseDrag:Connect(onRotate))
	track(arcs.MouseButton1Up:Connect(function() endDrag() end))
	track(moves.MouseButton1Down:Connect(function() beginDrag() end))
	track(moves.MouseDrag:Connect(onMove))
	track(moves.MouseButton1Up:Connect(function() endDrag() end))

	-- safety: never stay stuck in a drag
	track(UserInputService.InputEnded:Connect(function(input)
		if gz.busy and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			task.delay(0.05, function() endDrag() end)
		end
	end))

	-- tap a body part in the world to select its track
	local function pickJoint(pos)
		local cam = Workspace.CurrentCamera
		if not cam or not state.rig then return nil end
		local ray = cam:ViewportPointToRay(pos.X, pos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { state.rig }
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
		return hit and KEY_BY_PART[hit.Instance.Name] or nil
	end

	track(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not editor.live or not state.active then return end
		local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
		local isTouch = input.UserInputType == Enum.UserInputType.Touch
		if not (isMouse or isTouch) then return end
		local pos
		if isMouse then
			pos = UserInputService:GetMouseLocation()
		else
			local inset = GuiService:GetGuiInset()
			pos = Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
		end
		task.delay(0.06, function()
			if gz.busy or not editor.live or not state.active then return end
			local key = pickJoint(pos)
			if key then ed.selectJoint(key) end
		end)
	end))
end


------------------------------------------------------------------------
-- fx engine. everything here is created on your client only
------------------------------------------------------------------------
do
	local Lighting = cr(game:GetService("Lighting"))

	local function fxColor(name)
		if name == "rainbow" then
			return Color3.fromHSV((os.clock() * 0.25) % 1, 0.75, 1)
		end
		return FX_COLORS[name] or FX_COLORS.white
	end
	fx.color = fxColor

	pcall(function() RunService:UnbindFromRenderStep("MilkShake") end)

	local fxGui = Instance.new("ScreenGui")
	fxGui.Name = "MilkFX"
	fxGui.ResetOnSpawn = false
	fxGui.IgnoreGuiInset = true
	fxGui.DisplayOrder = 998
	fxGui.Parent = guiParent

	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Active = false
	flash.Parent = fxGui

	-- screen looks
	local POST = {
		none = false,
		bloom = { bloom = { 0.9, 24, 0.9 } },
		dreamy = {
			bloom = { 1.2, 40, 0.8 }, blur = 4,
			cc = { tint = Color3.fromRGB(255, 235, 245), sat = 0.15, con = -0.05, bri = 0.03 },
		},
		noir = { cc = { tint = Color3.fromRGB(255, 255, 255), sat = -1, con = 0.25, bri = -0.03 } },
		["neon night"] = {
			bloom = { 1.4, 30, 0.7 },
			cc = { tint = Color3.fromRGB(235, 225, 255), sat = 0.5, con = 0.2, bri = -0.12 },
		},
		sunset = {
			bloom = { 0.6, 20, 0.95 },
			cc = { tint = Color3.fromRGB(255, 205, 160), sat = 0.2, con = 0.1, bri = 0 },
		},
	}
	fx.postNames = { "none", "bloom", "dreamy", "noir", "neon night", "sunset" }

	local function postDrop(k)
		if fx.post[k] then
			pcall(function() fx.post[k]:Destroy() end)
			fx.post[k] = nil
		end
	end
	local function postMake(k, class)
		if not fx.post[k] or not fx.post[k].Parent then
			local inst = Instance.new(class)
			inst.Name = "Milk" .. k
			inst.Parent = Lighting
			fx.post[k] = inst
		end
		return fx.post[k]
	end

	local function ensurePost(name)
		local p = POST[name]
		if not p then
			postDrop("bloom")
			postDrop("blur")
			postDrop("cc")
			return
		end
		if p.bloom then
			local b = postMake("bloom", "BloomEffect")
			b.Intensity, b.Size, b.Threshold = p.bloom[1], p.bloom[2], p.bloom[3]
		else
			postDrop("bloom")
		end
		if p.blur then
			postMake("blur", "BlurEffect").Size = p.blur
		else
			postDrop("blur")
		end
		if p.cc then
			local c = postMake("cc", "ColorCorrectionEffect")
			c.TintColor, c.Saturation, c.Contrast, c.Brightness = p.cc.tint, p.cc.sat, p.cc.con, p.cc.bri
		else
			postDrop("cc")
		end
	end

	-- body effects
	local FOLLOW = { "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftHand", "RightHand", "LeftFoot", "RightFoot" }

	local function kill(name)
		local o = fx.objs[name]
		if o then
			pcall(function() o:Destroy() end)
			fx.objs[name] = nil
		end
		local ex = fx.extra[name]
		if ex then
			for _, inst in ipairs(ex) do pcall(function() inst:Destroy() end) end
			fx.extra[name] = nil
		end
	end

	local function ensure(name, on, make)
		local o = fx.objs[name]
		if on then
			if not o or not o.Parent then
				kill(name)
				o = make()
				fx.objs[name] = o
			end
			return o
		end
		kill(name)
		return nil
	end

	local function restoreNeon()
		for part, saved in pairs(fx.neonSaved) do
			pcall(function()
				part.Material = saved[1]
				part.Color = saved[2]
			end)
			fx.neonSaved[part] = nil
		end
		fx.neonOn = false
	end

	local function setNeon(vis, on)
		if on and not fx.neonOn then
			fx.neonOn = true
			for _, d in ipairs(vis:GetDescendants()) do
				if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
					fx.neonSaved[d] = { d.Material, d.Color }
					d.Material = Enum.Material.Neon
				end
			end
		elseif not on and fx.neonOn then
			restoreNeon()
		end
	end

	local function destroyBody()
		for name in pairs(fx.objs) do kill(name) end
		restoreNeon()
	end

	local function target()
		if not state.active then return nil, nil end
		local vis = (state.kind == "limb" and state.limb and state.limb.char) or state.rig
		local root = state.rig and state.rig:FindFirstChild("HumanoidRootPart")
		return vis, root
	end

	function fx.step()
		local vis, root = target()
		if not vis or not vis.Parent then
			if fx.visFor then
				destroyBody()
				fx.visFor = nil
			end
		else
			if fx.visFor ~= vis then
				destroyBody()
				fx.visFor = vis
			end
			local col = fxColor(cfg.FxColor)
			local torso = vis:FindFirstChild("Torso") or vis:FindFirstChild("UpperTorso")

			local aura = ensure("aura", cfg.Aura and torso ~= nil, function()
				local e = Instance.new("ParticleEmitter")
				e.Name = "MilkAura"
				e.Rate = 28
				e.Lifetime = NumberRange.new(0.8, 1.4)
				e.Speed = NumberRange.new(1, 3)
				e.SpreadAngle = Vector2.new(180, 180)
				e.LightEmission = 1
				e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
				e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
				e.Parent = torso
				return e
			end)
			if aura then aura.Color = ColorSequence.new(col) end

			for _, pn in ipairs(FOLLOW) do
				local part = vis:FindFirstChild(pn)
				local name = "trail_" .. pn
				local tr = ensure(name, cfg.Trails and part ~= nil, function()
					local a0 = Instance.new("Attachment")
					a0.Name = "MilkA0"
					a0.Position = Vector3.new(0, 0.9, 0)
					a0.Parent = part
					local a1 = Instance.new("Attachment")
					a1.Name = "MilkA1"
					a1.Position = Vector3.new(0, -0.9, 0)
					a1.Parent = part
					fx.extra[name] = { a0, a1 }
					local t = Instance.new("Trail")
					t.Name = "MilkTrail"
					t.Attachment0 = a0
					t.Attachment1 = a1
					t.Lifetime = 0.6
					t.LightEmission = 1
					t.FaceCamera = true
					t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
					t.Parent = part
					return t
				end)
				if tr then tr.Color = ColorSequence.new(col) end
			end

			local glow = ensure("glow", cfg.Glow, function()
				local h = Instance.new("Highlight")
				h.Name = "MilkGlow"
				h.Adornee = vis
				h.FillTransparency = 0.7
				h.OutlineTransparency = 0
				h.Parent = gui
				return h
			end)
			if glow then
				glow.FillColor = col
				glow.OutlineColor = col
			end

			local light = ensure("light", cfg.BodyLight and torso ~= nil, function()
				local l = Instance.new("PointLight")
				l.Name = "MilkLight"
				l.Brightness = 2.5
				l.Range = 20
				l.Parent = torso
				return l
			end)
			if light then light.Color = col end

			setNeon(vis, cfg.Neon)

			local ring = ensure("ring", cfg.Ring and root ~= nil, function()
				local p = Instance.new("Part")
				p.Name = "MilkRing"
				p.Shape = Enum.PartType.Cylinder
				p.Size = Vector3.new(0.15, 7, 7)
				p.Material = Enum.Material.Neon
				p.Transparency = 0.35
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.CastShadow = false
				p.Parent = Workspace
				return p
			end)
			if ring and root then
				ring.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.9, 0))
					* CFrame.Angles(0, os.clock() * 1.5, 0) * CFrame.Angles(0, 0, math.pi / 2)
				ring.Color = col
			end
		end

		if fx.postName ~= cfg.PostPreset then
			fx.postName = cfg.PostPreset
			ensurePost(cfg.PostPreset)
		end

		if cfg.ClockOn then
			if not fx.savedClock then fx.savedClock = Lighting.ClockTime end
			Lighting.ClockTime = cfg.Clock
		elseif fx.savedClock then
			Lighting.ClockTime = fx.savedClock
			fx.savedClock = nil
		end
	end
	track(RunService.RenderStepped:Connect(fx.step))

	-- timeline events
	function fx.fire(kind, colName)
		local col = fxColor(colName)
		local vis, root = target()
		local cam = Workspace.CurrentCamera
		if kind == "burst" then
			local torso = vis and (vis:FindFirstChild("Torso") or vis:FindFirstChild("UpperTorso"))
			if not torso then return end
			local e = Instance.new("ParticleEmitter")
			e.Rate = 0
			e.Lifetime = NumberRange.new(0.6, 1.2)
			e.Speed = NumberRange.new(14, 26)
			e.SpreadAngle = Vector2.new(180, 180)
			e.LightEmission = 1
			e.Color = ColorSequence.new(col)
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			e.Parent = torso
			e:Emit(50)
			task.delay(2, function() pcall(function() e:Destroy() end) end)
		elseif kind == "flash" then
			flash.BackgroundColor3 = col
			flash.BackgroundTransparency = 0.3
			TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		elseif kind == "shake" then
			fx.shake = 0.6
			fx.shakeMag = 0.6
		elseif kind == "fov" then
			if cam then
				local base = cam.FieldOfView
				cam.FieldOfView = base + 18
				TweenService:Create(cam, TweenInfo.new(0.5), { FieldOfView = base }):Play()
			end
		elseif kind == "ring" then
			if not root then return end
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.2, 2, 2)
			p.Material = Enum.Material.Neon
			p.Color = col
			p.Transparency = 0.2
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			p.Parent = Workspace
			TweenService:Create(p, TweenInfo.new(0.9), { Size = Vector3.new(0.2, 28, 28), Transparency = 1 }):Play()
			task.delay(1, function() pcall(function() p:Destroy() end) end)
		elseif kind == "tint" then
			local c = postMake("tint", "ColorCorrectionEffect")
			c.TintColor = col
			c.Saturation = 0.4
			TweenService:Create(c, TweenInfo.new(0.9), { TintColor = Color3.new(1, 1, 1), Saturation = 0 }):Play()
		end
	end

	function fx.fireRange(anim, t0, t1)
		if not anim.events then return end
		for _, e in ipairs(anim.events) do
			if e.t > t0 and e.t <= t1 then fx.fire(e.kind, e.col) end
		end
	end

	RunService:BindToRenderStep("MilkShake", Enum.RenderPriority.Camera.Value + 2, function(dt)
		if fx.shake > 0 then
			fx.shake -= dt
			local cam = Workspace.CurrentCamera
			if cam then
				local m = fx.shakeMag * math.clamp(fx.shake / 0.6, 0, 1)
				cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
			end
		end
	end)

	function fx.cleanup()
		destroyBody()
		for k in pairs(fx.post) do postDrop(k) end
		if fx.savedClock then
			pcall(function() Lighting.ClockTime = fx.savedClock end)
			fx.savedClock = nil
		end
		pcall(function() RunService:UnbindFromRenderStep("MilkShake") end)
		pcall(function() fxGui:Destroy() end)
	end
end


------------------------------------------------------------------------
-- community library (json data only, never code)
------------------------------------------------------------------------
local lib = { rows = {}, items = {} }

local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" then
		return #res <= 500000 and res or nil
	end
	if request then
		local ok2, r = pcall(request, { Url = url, Method = "GET" })
		if ok2 and r and r.Success and type(r.Body) == "string" and #r.Body <= 500000 then
			return r.Body
		end
	end
	return nil
end

local function libBase()
	local u = settings.libraryUrl
	if not u:match("^https://") then return nil end
	if not u:match("/$") then u = u .. "/" end
	return u
end

local function downloadEntry(entry)
	local base = libBase()
	if not base then return end
	setStatus("downloading " .. entry.name .. "...", "sub")
	task.spawn(function()
		local body = httpGet(base .. entry.file)
		if not body then
			setStatus("download failed", "bad")
			return
		end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		local anim, err = nil, nil
		if ok then anim, err = sanitizeAnim(data) end
		if not anim then
			setStatus("bad animation file: " .. tostring(err or "json"), "bad")
			return
		end
		if hasFS then
			ensureFolders()
			pcall(writefile, ROOT .. "/anims/" .. safeName(anim.name) .. ".json", HttpService:JSONEncode(anim))
			refreshLocal()
		end
		loadIntoEditor(anim)
		setStatus("downloaded " .. anim.name .. ". open editor, press play.", "good")
	end)
end


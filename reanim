local function safeName(s)
	s = tostring(s or ""):gsub("[^%w_%-]", "_")
	s = s:sub(1, 40)
	if s == "" then s = "untitled" end
	return s
end

local function ensureFolders()
	if not hasFS then return end
	pcall(makefolder, ROOT)
	pcall(makefolder, ROOT .. "/anims")
	pcall(makefolder, ROOT .. "/music")
end

local function saveSettings()
	if not hasFS then return end
	ensureFolders()
	pcall(writefile, ROOT .. "/settings.json", HttpService:JSONEncode(settings))
end

local function loadSettings()
	if not hasFS then return end
	local ok, data = pcall(function()
		if isfile(ROOT .. "/settings.json") then
			return HttpService:JSONDecode(readfile(ROOT .. "/settings.json"))
		end
	end)
	if ok and type(data) == "table" then
		if data.theme == "dark" or data.theme == "milk" then settings.theme = data.theme end
		if type(data.libraryUrl) == "string" and #data.libraryUrl < 300 then
			settings.libraryUrl = data.libraryUrl
		end
	end
end
loadSettings()

local theme = THEMES[settings.theme] or THEMES.milk

local function skin(inst, prop, key)
	table.insert(themed, { inst, prop, key })
	inst[prop] = theme[key]
	return inst
end

local function applyTheme(name)
	theme = THEMES[name] or THEMES.milk
	settings.theme = THEMES[name] and name or "milk"
	for i = #themed, 1, -1 do
		local t = themed[i]
		if t[1].Parent then
			t[1][t[2]] = theme[t[3]]
		else
			table.remove(themed, i)
		end
	end
	for _, f in ipairs(themeHooks) do pcall(f) end
	saveSettings()
end


local function normalizeId(raw)
	local digits = string.match(tostring(raw), "%d+")
	if not digits then return nil end
	return "rbxassetid://" .. digits
end

stopAnim = function()
	local t = state.track
	state.track = nil
	if t then
		pcall(function() t:Stop(0.2) end)
		pcall(function() t:Destroy() end)
	end
end

playAnim = function(id)
	if not state.active or not state.rigHum then
		setStatus("start reanimate first", "bad")
		return
	end
	local assetId = normalizeId(id)

local function slider(page, text, min, max, dec, get, set)
	local spec = { text = text, min = min, max = max, dec = dec, get = get, set = set }
	local row = newRow(page, "Frame", 44)
	local nameLbl = mkLabel(row, text, UDim2.new(1, -80, 0, 20), UDim2.fromOffset(12, 4),
		Enum.Font.Gotham, 13, "text", Enum.TextXAlignment.Left)
	local valueLbl = mkLabel(row, "", UDim2.fromOffset(60, 20), UDim2.new(1, -72, 0, 4),
		Enum.Font.GothamBold, 12, "sub", Enum.TextXAlignment.Right)

	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, -24, 0, 6)
	bar.Position = UDim2.new(0, 12, 0, 30)
	bar.BorderSizePixel = 0
	bar.AutoButtonColor = false
	bar.Text = ""
	bar.Parent = row
	skin(bar, "BackgroundColor3", "panel")
	corner(bar, 3)

	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.Parent = bar
	skin(fill, "BackgroundColor3", "accent")
	corner(fill, 3)

	local ctrl = { row = row, spec = spec }
	function ctrl.render()
		nameLbl.Text = spec.text
		local v = spec.get()
		local span = spec.max - spec.min
		fill.Size = UDim2.fromScale(span > 0 and math.clamp((v - spec.min) / span, 0, 1) or 0, 1)
		valueLbl.Text = string.format("%." .. spec.dec .. "f", v)
	end
	local function apply(v)
		local mult = 10 ^ spec.dec
		v = math.clamp(math.floor(v * mult + 0.5) / mult, spec.min, spec.max)
		spec.set(v)
		ctrl.render()
	end
	ctrl.render()

	local function fromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		apply(spec.min + (spec.max - spec.min) * alpha)
	end
	track(bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromX
			fromX(input.Position.X)
		end
	end))
	return ctrl
end


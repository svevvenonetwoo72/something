local function readMode()
	if not hasFS then return nil end
	local ok, data = pcall(function()
		if isfile(ROOT .. "/mode.txt") then return readfile(ROOT .. "/mode.txt") end
	end)
	if ok and (data == "compat" or data == "full") then return data end
	return nil
end

local function writeMode(m)
	if not hasFS then return end
	pcall(makefolder, ROOT)
	pcall(writefile, ROOT .. "/mode.txt", m)
end

local function setMode(newMode)
	if newMode == "full" and not (type(Drawing) == "table" or type(Drawing) == "userdata")
		or (newMode == "full" and not Drawing.new) then
		newMode = "compat"
		setStatus("no drawing library here. using compat mode.", theme.bad)
	end
	mode = newMode

	for _, o in pairs(objects) do destroyOverlay(o) end
	if fovCircle then fovCircle.destroy() end
	if silentCircle then silentCircle.destroy() end

	backend = (mode == "full") and makeDrawBackend() or makeGuiBackend()
	fovCircle = backend.newCircle()
	silentCircle = backend.newCircle()
	for _, o in pairs(objects) do buildOverlay(o) end

	if mode == "compat" then
		cfg.SilentAim = false
	end
	writeMode(mode)
end


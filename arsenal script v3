-- minimize
local minimized = false
track(minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "-"
	if minimized then
		body.Visible = false
	else
		task.delay(0.12, function()
			if not minimized and main.Parent then body.Visible = true end
		end)
	end
	TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
		Size = minimized and COLLAPSED or EXPANDED,
	}):Play()
end))

-- drag + slider drag
do
	local dragging = false
	local dragStart, startPos
	track(header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		if not isMove then return end
		if activeSlider then
			activeSlider(input.Position.X)
		elseif dragging then
			local delta = input.Position - dragStart
			local screen = gui.AbsoluteSize
			local x = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, screen.X - 120))
			local y = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, screen.Y - 40))
			main.Position = UDim2.fromOffset(x, y)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			activeSlider = nil
		end
	end))
end

cleanup = function()
	silent.active = false
	for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
	connections = {}
	for part in pairs(hitboxOrig) do restoreHitbox(part) end
	for plr in pairs(objects) do removePlayer(plr) end
	if fovCircle then fovCircle.destroy() end
	if silentCircle then silentCircle.destroy() end
	pcall(setFullbright, false)
	pcall(function()
		local cam = Workspace.CurrentCamera
		if cam then cam.FieldOfView = origFOV end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.PlatformStand = false end
	end)
	pcall(function() gui:Destroy() end)
end

env.MilkCleanup = cleanup

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	local k = input.KeyCode
	if k == Enum.KeyCode.RightShift then
		main.Visible = not main.Visible
	elseif k == Enum.KeyCode.Insert then
		cfg.ESP = not cfg.ESP
		refreshers.ESP()
	elseif k == Enum.KeyCode.Delete then
		cfg.Aimbot = not cfg.Aimbot
		refreshers.Aimbot()
	elseif k == Enum.KeyCode.Home then
		cfg.Speed = not cfg.Speed
		refreshers.Speed()
	elseif k == Enum.KeyCode.End then
		cleanup()
	end
end))

------------------------------------------------------------------------
-- startup: ask which executor, or use the saved answer
------------------------------------------------------------------------
cfg.ModeShown = "compat"

local function finishStart(m)
	setMode(m)
	cfg.ModeShown = mode
	modeLabel.Text = mode
	main.Visible = true
	setStatus("mode: " .. mode .. ". insert esp | delete aim | end unload")
end

local function askExecutor()
	local detected = "unknown"
	pcall(function()
		if identifyexecutor then detected = tostring((identifyexecutor())) end
	end)
	local low = string.lower(detected)
	local suggestCompat = low:find("xeno") ~= nil or low:find("solara") ~= nil

	local prompt = Instance.new("Frame")
	prompt.Size = UDim2.fromOffset(320, 210)
	prompt.AnchorPoint = Vector2.new(0.5, 0.5)
	prompt.Position = UDim2.fromScale(0.5, 0.5)
	prompt.BackgroundColor3 = theme.bg
	prompt.BorderSizePixel = 0
	prompt.Active = true
	prompt.ZIndex = 50
	prompt.Parent = gui
	corner(prompt, 12)
	local ps = Instance.new("UIStroke")
	ps.Color = theme.off
	ps.Parent = prompt

	local t1 = label(prompt, "which executor are you using?", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 12),
		Enum.Font.GothamBold, 16, theme.text, Enum.TextXAlignment.Left)
	t1.ZIndex = 51
	local t2 = label(prompt, "detected: " .. detected, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 40),
		Enum.Font.Gotham, 12, theme.sub, Enum.TextXAlignment.Left)
	t2.ZIndex = 51

	local function choice(text, sub, y, isSuggested, m)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -24, 0, 56)
		b.Position = UDim2.fromOffset(12, y)
		b.BackgroundColor3 = isSuggested and theme.accent or theme.item
		b.BorderSizePixel = 0
		b.AutoButtonColor = true
		b.Text = ""
		b.ZIndex = 51
		b.Parent = prompt
		corner(b, 8)
		local a = label(b, text, UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 6), Enum.Font.GothamBold, 14,
			Color3.new(1, 1, 1), Enum.TextXAlignment.Left)
		a.ZIndex = 52
		local c = label(b, sub, UDim2.new(1, -20, 0, 18), UDim2.fromOffset(10, 30), Enum.Font.Gotham, 11,
			isSuggested and Color3.new(1, 1, 1) or theme.sub, Enum.TextXAlignment.Left)
		c.ZIndex = 52
		track(b.MouseButton1Click:Connect(function()
			prompt:Destroy()
			finishStart(m)
		end))
	end
	choice("xeno / solara", "compat: plain gui overlay, no hooks", 70, suggestCompat, "compat")
	choice("other (high unc)", "full: drawing overlay, better arrows, silent aim", 134, not suggestCompat and detected ~= "unknown", "full")
end

local saved = readMode()
if saved then
	finishStart(saved)
else
	askExecutor()
end

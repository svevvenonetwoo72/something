local function slider(page, text, key, min, max, decimals)
	local row = newRow(page, "Frame", 44)
	label(row, text, UDim2.new(1, -80, 0, 20), UDim2.fromOffset(12, 4), Enum.Font.Gotham, 13, theme.text, Enum.TextXAlignment.Left)
	local valueLbl = label(row, "", UDim2.fromOffset(60, 20), UDim2.new(1, -72, 0, 4), Enum.Font.GothamBold, 12, theme.sub, Enum.TextXAlignment.Right)

	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, -24, 0, 6)
	bar.Position = UDim2.new(0, 12, 0, 30)
	bar.BackgroundColor3 = theme.off
	bar.BorderSizePixel = 0
	bar.AutoButtonColor = false
	bar.Text = ""
	bar.Parent = row
	corner(bar, 3)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = theme.accent
	fill.BorderSizePixel = 0
	fill.Parent = bar
	corner(fill, 3)

	local mult = 10 ^ decimals
	local function setValue(v)
		v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		cfg[key] = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		valueLbl.Text = tostring(v)
	end
	setValue(cfg[key])

	local function fromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * alpha)
	end
	track(bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromX
			fromX(input.Position.X)
		end
	end))
end


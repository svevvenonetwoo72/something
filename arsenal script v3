local function drawSkeleton(o, char, camera)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local defs = (hum and hum.RigType == Enum.HumanoidRigType.R15) and R15_BONES or R6_BONES
	while #o.bones < #defs do
		table.insert(o.bones, backend.newLine())
	end
	for i, def in ipairs(defs) do
		local line = o.bones[i]
		local a = char:FindFirstChild(def[1])
		local b = char:FindFirstChild(def[3])
		local drawn = false
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			local sa, onA = camera:WorldToViewportPoint((a.CFrame * def[2]))
			local sb, onB = camera:WorldToViewportPoint((b.CFrame * def[4]))
			if onA and onB and sa.Z > 0 and sb.Z > 0 then
				line.set(Vector2.new(sa.X, sa.Y), Vector2.new(sb.X, sb.Y), Color3.new(1, 1, 1), cfg.SkeletonThickness)
				drawn = true
			end
		end
		if not drawn then line.hide() end
	end
	for i = #defs + 1, #o.bones do o.bones[i].hide() end
end

local function drawArrow(o, camera, rootPos, dist, hpFrac, viewport)
	local sp, onScreen = camera:WorldToViewportPoint(rootPos)
	if onScreen and sp.Z > 0 then
		o.arrow.hide()
		return
	end
	local rel = camera.CFrame:PointToObjectSpace(rootPos)
	local d = Vector2.new(rel.X, rel.Z)
	if d.Magnitude < 0.001 then
		o.arrow.hide()
		return
	end
	local dir = d.Unit
	local center = viewport / 2
	local text = string.format("%dm", dist)

	if mode == "full" then
		local rx = math.min(cfg.ArrowRadius * 1.3, viewport.X * 0.5 - 40)
		local ry = math.min(cfg.ArrowRadius, viewport.Y * 0.5 - 40)
		local pos = center + Vector2.new(dir.X * rx, dir.Y * ry)
		local size = math.clamp(24 - dist / 40, 12, 24)
		if dist < 40 then
			size = size * (1 + 0.12 * math.sin(os.clock() * 9))
		end
		o.arrow.set({
			pos = pos, dir = dir, size = size, text = text,
			color = Color3.fromHSV(0.33 * math.clamp(hpFrac, 0, 1), 0.85, 1),
			alpha = math.clamp(1 - dist / (cfg.ArrowMaxDist * 1.2), 0.4, 1),
		})
	else
		local r = cfg.ArrowRadius
		local pos = center + dir * r
		o.arrow.set({ pos = pos, dir = dir, size = 14, text = text, color = cfg.EnemyColor, alpha = 1 })
	end
end

------------------------------------------------------------------------
-- targeting
------------------------------------------------------------------------
local lockedPlr = nil

local function partFor(char)
	return char:FindFirstChild(cfg.AimPart) or char:FindFirstChild("HumanoidRootPart")
end

local function evaluate(plr, camera, center, fov)
	if not isEnemy(plr) then return nil end
	local char = plr.Character
	if not isAlive(char) then return nil end
	local part = partFor(char)
	if not part then return nil end
	local pos = part.Position + part.AssemblyLinearVelocity * cfg.Prediction
	local screen, onScreen = camera:WorldToViewportPoint(pos)
	if not (onScreen and screen.Z > 0) then return nil end
	local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
	if dist > fov then return nil end
	if cfg.WallCheck and not canSee(camera, part, char) then return nil end
	return part, dist, pos
end

local function findTarget(camera, center, fov)
	local bestPlr, bestPart, bestPos, bestDist
	for _, plr in ipairs(Players:GetPlayers()) do
		local part, dist, pos = evaluate(plr, camera, center, fov)
		if part and (not bestDist or dist < bestDist) then
			bestPlr, bestPart, bestPos, bestDist = plr, part, pos, dist
		end
	end
	return bestPlr, bestPart, bestPos
end

local function acquire(camera, center)
	if cfg.Sticky and lockedPlr then
		local part, _, pos = evaluate(lockedPlr, camera, center, cfg.FOV * 1.5)
		if part then return lockedPlr, part, pos end
	end
	return findTarget(camera, center, cfg.FOV)
end

------------------------------------------------------------------------
-- silent aim (full mode only: needs hooks)
------------------------------------------------------------------------
local silent = env.MilkSilent
if not silent then
	silent = { active = false, pos = nil, part = nil, chance = 100, installed = false }
	env.MilkSilent = silent
end
silent.active = false
silent.ws = RealWorkspace
silent.mouse = LocalPlayer:GetMouse()

local function installSilent()
	if silent.installed then return true end
	if not (hookmetamethod and getnamecallmethod) then return false end
	local checkcaller = checkcaller or function() return false end
	local wrap = newcclosure or function(f) return f end

	local okNamecall = pcall(function()
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
			local method = getnamecallmethod()
			if silent.active and silent.pos and self == silent.ws and not checkcaller() then
				if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay"
					or method == "FindPartOnRayWithWhitelist" then
					local args = table.pack(...)
					local ray = args[1]
					if typeof(ray) == "Ray" and math.random(1, 100) <= silent.chance then
						local origin = ray.Origin
						local length = math.max(ray.Direction.Magnitude, (silent.pos - origin).Magnitude + 5)
						args[1] = Ray.new(origin, (silent.pos - origin).Unit * length)
						return oldNamecall(self, table.unpack(args, 1, args.n))
					end
				elseif method == "Raycast" then
					local args = table.pack(...)
					local origin, direction = args[1], args[2]
					if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
						and math.random(1, 100) <= silent.chance then
						local length = math.max(direction.Magnitude, (silent.pos - origin).Magnitude + 5)
						args[2] = (silent.pos - origin).Unit * length
						return oldNamecall(self, table.unpack(args, 1, args.n))
					end
				end
			end
			return oldNamecall(self, ...)
		end))
	end)
	if not okNamecall then return false end

	pcall(function()
		local oldIndex
		oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
			if silent.active and silent.pos and self == silent.mouse
				and (key == "Hit" or key == "Target") and not checkcaller() then
				if math.random(1, 100) <= silent.chance then
					if key == "Hit" then return CFrame.new(silent.pos) end
					return silent.part
				end
			end
			return oldIndex(self, key)
		end))
	end)

	silent.installed = true
	return true
end

------------------------------------------------------------------------
-- hitbox expander
------------------------------------------------------------------------
local hitboxOrig = {}

local function restoreHitbox(part)
	local s = hitboxOrig[part]
	if s then
		pcall(function()
			part.Size = s[1]
			part.Transparency = s[2]
			part.CanCollide = s[3]
		end)
		hitboxOrig[part] = nil
	end
end

local function hitboxPartOf(char)
	local k = cfg.HitboxPart
	if k == "Head" then return char:FindFirstChild("Head") end
	if k == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") end
	return char:FindFirstChild("HumanoidRootPart")
end

local function updateHitboxes()
	local active = {}
	if cfg.Hitbox then
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			if isEnemy(plr) and isAlive(char) then
				local part = hitboxPartOf(char)
				if part then
					active[part] = true
					if not hitboxOrig[part] then
						hitboxOrig[part] = { part.Size, part.Transparency, part.CanCollide }
					end
					local s = cfg.HitboxSize
					part.Size = Vector3.new(s, s, s)
					part.Transparency = cfg.HitboxAlpha
					part.CanCollide = false
				end
			end
		end
	end
	for part in pairs(hitboxOrig) do
		if not active[part] then restoreHitbox(part) end
	end
end


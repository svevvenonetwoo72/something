track(RunService.RenderStepped:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	if not camera or not backend then return end
	local viewport = camera.ViewportSize
	local mouse = UserInputService:GetMouseLocation()
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	if cfg.ShowFOV and cfg.Aimbot then
		fovCircle.set(mouse, cfg.FOV, Color3.new(1, 1, 1))
	else
		fovCircle.hide()
	end
	if cfg.ShowFOV and cfg.SilentAim then
		silentCircle.set(mouse, cfg.SilentFOV, Color3.fromRGB(90, 200, 255))
	else
		silentCircle.hide()
	end

	dot.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)
	dot.Visible = cfg.Crosshair

	if cfg.CamFOVOn then camera.FieldOfView = cfg.CamFOV end
	if cfg.Fullbright then applyFullbright() end

	for plr, o in pairs(objects) do
		local char = plr.Character
		local show = cfg.ESP and isEnemy(plr) and isAlive(char)
		local root = show and char:FindFirstChild("HumanoidRootPart")
		local head = show and char:FindFirstChild("Head")

		if show and root and head then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0

			o.hl.Adornee = char
			o.hl.Enabled = true
			o.bb.Adornee = head
			o.bb.Enabled = cfg.Names
			o.label.Text = string.format("%s | %d hp | %dm", plr.DisplayName, math.floor(hum.Health), math.floor(dist))

			if cfg.Tracers then
				local s, on = camera:WorldToViewportPoint(root.Position)
				if on and s.Z > 0 then
					o.tracer.set(Vector2.new(viewport.X / 2, viewport.Y), Vector2.new(s.X, s.Y), cfg.EnemyColor, 1.5)
				else
					o.tracer.hide()
				end
			else
				o.tracer.hide()
			end

			if cfg.Skeleton then
				drawSkeleton(o, char, camera)
			else
				for _, b in ipairs(o.bones) do b.hide() end
			end

			if cfg.Arrows and dist <= cfg.ArrowMaxDist then
				drawArrow(o, camera, root.Position, math.floor(dist), hum.Health / math.max(hum.MaxHealth, 1), viewport)
			else
				o.arrow.hide()
			end
		else
			o.hl.Enabled = false
			o.bb.Enabled = false
			hideOverlay(o)
		end
	end

	-- aimbot
	local down = UserInputService:IsMouseButtonPressed(cfg.AimKey)
	if down and not wasDown then aimToggled = not aimToggled end
	wasDown = down

	local wantAim = cfg.Aimbot and (
		(cfg.AimMode == "Hold" and down)
		or (cfg.AimMode == "Toggle" and aimToggled)
		or cfg.AimMode == "Always"
	)
	if wantAim then
		local plr, _, pos = acquire(camera, mouse)
		lockedPlr = plr
		if plr and pos then
			local alpha = 1 - math.exp(-cfg.AimSpeed * dt)
			camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, pos), alpha)
			hud.Text = "locked: " .. plr.DisplayName
		else
			hud.Text = "aim: searching"
		end
	else
		lockedPlr = nil
		hud.Text = cfg.Aimbot and ("aim: " .. string.lower(cfg.AimMode)) or ""
	end

	-- silent aim target
	if cfg.SilentAim and silent.installed then
		local _, sPart, sPos = findTarget(camera, mouse, cfg.SilentFOV)
		silent.part = sPart
		silent.pos = sPos
		silent.chance = cfg.HitChance
		silent.active = sPart ~= nil
	else
		silent.active = false
	end
end))

-- movement, triggerbot, hitboxes
local flying = false
local lastClick = 0

local function clickMouse()
	if mouse1click then
		pcall(mouse1click)
	elseif mouse1press and mouse1release then
		pcall(mouse1press)
		task.delay(0.02, function() pcall(mouse1release) end)
	end
end

track(RunService.Heartbeat:Connect(function()
	local camera = Workspace.CurrentCamera
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	updateHitboxes()

	if cfg.Noclip and char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end

	if hum and root and hum.Health > 0 then
		if cfg.Fly and camera then
			flying = true
			hum.PlatformStand = true
			local dir = Vector3.zero
			if not UserInputService:GetFocusedTextBox() then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
			end
			root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * cfg.FlySpeed or Vector3.zero
		else
			if flying then
				flying = false
				hum.PlatformStand = false
			end
			if cfg.Speed and hum.MoveDirection.Magnitude > 0.1 then
				local move = hum.MoveDirection
				local vel = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(move.X * cfg.SpeedValue, vel.Y, move.Z * cfg.SpeedValue)
			end
		end
	end

	if cfg.Trigger and camera and os.clock() - lastClick >= math.max(cfg.TriggerDelay, 0.03) then
		local viewport = camera.ViewportSize
		local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
		setIgnore(camera)
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
		if hit then
			for _, plr in ipairs(Players:GetPlayers()) do
				local pc = plr.Character
				if isEnemy(plr) and isAlive(pc) and hit.Instance:IsDescendantOf(pc) then
					lastClick = os.clock()
					clickMouse()
					break
				end
			end
		end
	end
end))


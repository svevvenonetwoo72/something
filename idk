-- fly (camera relative, smoothed) -----------------------------------------

local fly = { bv = nil, bg = nil, vel = Vector3.zero, tilt = 0 }

local function sweepMovers()
	local ch = lp.Character
	if not ch then return end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BodyVelocity") or d:IsA("BodyGyro") then
			d:Destroy()
		end
	end
end

local function flyStop()
	sweepMovers()
	if fly.bv then fly.bv:Destroy() fly.bv = nil end
	-- rest of the function stays the same
	if fly.bv then fly.bv:Destroy() fly.bv = nil end
	if fly.bg then fly.bg:Destroy() fly.bg = nil end
	fly.vel = Vector3.zero
	fly.tilt = 0

	local _, hum, root = getChar()
	if root then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 1e-3 then flat = Vector3.new(0, 0, -1) end
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function flyEnsure(hum, root)
	if not fly.bv or fly.bv.Parent ~= root then
		if fly.bv then fly.bv:Destroy() end
		fly.bv = make("BodyVelocity", { MaxForce = Vector3.one * 9e9, Velocity = Vector3.zero }, root)
	end
	if not fly.bg or fly.bg.Parent ~= root then
		if fly.bg then fly.bg:Destroy() end
		fly.bg = make("BodyGyro", { MaxTorque = Vector3.one * 9e9, P = 9e4, D = 1e3, CFrame = root.CFrame }, root)
	end
	if not hum.PlatformStand then hum.PlatformStand = true end
end

local function key(k) return UIS:IsKeyDown(k) and 1 or 0 end

track(RunService.RenderStepped:Connect(function(dt)
	if not st.fly or not alive then return end
	local _, hum, root = getChar()
	local cam = workspace.CurrentCamera
	if not hum or not root or not cam or hum.Health <= 0 then return end

	flyEnsure(hum, root)

	local cf = cam.CFrame
	local fwd, side, up = 0, 0, 0
	if not UIS:GetFocusedTextBox() then
		fwd = key(Enum.KeyCode.W) - key(Enum.KeyCode.S)
		side = key(Enum.KeyCode.D) - key(Enum.KeyCode.A)
		up = key(Enum.KeyCode.E) + key(Enum.KeyCode.Space) - key(Enum.KeyCode.Q) - key(Enum.KeyCode.LeftControl)
		up = math.clamp(up, -1, 1)
	end

	local dir = cf.LookVector * fwd + cf.RightVector * side + Vector3.yAxis * up
	if fwd == 0 and side == 0 and up == 0 and hum.MoveDirection.Magnitude > 0 then
		dir = hum.MoveDirection
	end

	local speed = math.max(st.flyVal, 1)
	local target = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
	local alpha = 1 - math.exp(-dt * 9)

	fly.vel = fly.vel:Lerp(target, alpha)
	fly.bv.Velocity = fly.vel

	local tiltTarget = math.clamp(fly.vel:Dot(cf.LookVector) / speed, -1, 1) * math.rad(40)
	fly.tilt += (tiltTarget - fly.tilt) * alpha
	fly.bg.CFrame = cf * CFrame.Angles(-fly.tilt, 0, 0)
end))


-- core loops --------------------------------------------------------------

track(RunService.Heartbeat:Connect(function()
	local _, hum, root = getChar()
	if not hum or not root then return end
	if st.speed then hum.WalkSpeed = st.speedVal end
	if st.jump then hum.UseJumpPower = true hum.JumpPower = st.jumpVal end
	if st.fly then
		local y = 0
		if UIS:IsKeyDown(Enum.KeyCode.Space) then y = 1
		elseif UIS:IsKeyDown(Enum.KeyCode.LeftControl) then y = -1 end
		root.AssemblyLinearVelocity = hum.MoveDirection * st.flyVal + Vector3.new(0, y * st.flyVal, 0)
	end
end))

track(RunService.Stepped:Connect(function()
	if not st.noclip then return end
	local ch = lp.Character
	if not ch then return end
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
	end
end))

track(UIS.JumpRequest:Connect(function()
	if st.infjump then
		local _, hum = getChar()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end))

-- unload ------------------------------------------------------------------

local function cleanup()
	alive = false
	st.spy, st.fly, st.noclip, st.speed, st.jump, st.infjump = false, false, false, false, false, false
	if hookInstalled and hookOld then
		pcall(hookmetamethod, game, "__namecall", hookOld)
	end
	local _, hum, root = getChar()
	if hum then hum.WalkSpeed = orig.ws hum.UseJumpPower = true hum.JumpPower = orig.jp end
	if root then root.AssemblyLinearVelocity = Vector3.zero end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	if gui then gui:Destroy() end
	genv.MilkObbyCleanup = nil
end
genv.MilkObbyCleanup = cleanup


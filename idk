local function refreshRemotes()
	for _, c in ipairs(remoteList:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local q = filter.Text:lower()
	local n = 0
	for _, d in ipairs(game:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			if not d:IsDescendantOf(CoreGui) then
				local path = d:GetFullName()
				if q == "" or path:lower():find(q, 1, true) then
					n += 1
					if n > 250 then break end
					addRow(remoteList, (d:IsA("RemoteEvent") and "[E] " or "[F] ") .. path, function() selectRemote(d) end, n)
				end
			end
		end
	end
	setStatus(n .. " remotes listed")
end

local function fireSelected()
	if not selected or not selected.Parent then setStatus("no valid remote selected") return end
	local fn, err = loadstring("return " .. argBox.Text)
	if not fn then setStatus("parse error: " .. tostring(err)) return end
	pcall(setfenv, fn, argEnv)
	local ok, packed = pcall(function() return table.pack(fn()) end)
	if not ok then setStatus("arg error: " .. tostring(packed)) return end
	local remote = selected
	task.spawn(function()
		local ok2, res = pcall(function()
			if remote:IsA("RemoteEvent") then
				remote:FireServer(table.unpack(packed, 1, packed.n))
				return "fired"
			elseif remote:IsA("RemoteFunction") then
				return "returned: " .. ser(remote:InvokeServer(table.unpack(packed, 1, packed.n)))
			end
			return "not a remote"
		end)
		if alive then setStatus(ok2 and res or ("error: " .. tostring(res))) end
	end)
end


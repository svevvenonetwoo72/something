local logQueue, logCount = {}, 0

local function addLog(remote, method, args)
	if not alive or not logList then return end
	logCount += 1
	local argStr = ""
	pcall(function() argStr = serArgs(args) end)
	local tag = method == "FireServer" and "[E] " or "[F] "
	local row = addRow(logList, tag .. remote.Name .. "(" .. argStr .. ")", function()
		selectRemote(remote)
		argBox.Text = argStr
		selectPage("remotes")
		setStatus("loaded from spy")
	end, -logCount)
	logQueue[#logQueue + 1] = row
	if #logQueue > 80 then
		local old = table.remove(logQueue, 1)
		if old then old:Destroy() end
	end
end


if hookmetamethod and getnamecallmethod then
	local wrap = newcclosure or function(f) return f end
	local ok = pcall(function()
		hookOld = hookmetamethod(game, "__namecall", wrap(function(self, ...)
			local m = getnamecallmethod()
			if st.spy and alive and (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance"
				and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction") and not checkcaller() then
				local args = table.pack(...)
				task.defer(addLog, self, m, args)
			end
			return hookOld(self, ...)
		end))
	end)
	hookInstalled = ok and hookOld ~= nil
end


	elseif kind == "bad" then
		skin(btn, "BackgroundColor3", "bad")
		btn.TextColor3 = Color3.new(1, 1, 1)
	else
		skin(btn, "TextColor3", "text")
	end
	track(btn.MouseButton1Click:Connect(callback))
	return btn
end


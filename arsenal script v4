local origFOV = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70

local function serverHop()
	setStatus("finding server...")
	task.spawn(function()
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
		local body
		local ok, res = pcall(function() return game:HttpGet(url) end)
		if ok and type(res) == "string" then
			body = res
		elseif request then
			local ok2, r = pcall(request, { Url = url, Method = "GET" })
			if ok2 and r and r.Success then body = r.Body end
		end
		if not body then
			setStatus("hop failed: no response", theme.bad)
			return
		end
		local okDecode, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not okDecode or type(data) ~= "table" or type(data.data) ~= "table" then
			setStatus("hop failed: bad data", theme.bad)
			return
		end
		local options = {}
		for _, s in ipairs(data.data) do
			if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
				table.insert(options, s.id)
			end
		end
		if #options == 0 then
			setStatus("no servers found", theme.bad)
			return
		end
		pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, options[math.random(1, #options)], LocalPlayer)
		end)
	end)
end


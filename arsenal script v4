local function isAlive(char)
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function isEnemy(plr)
	if plr == LocalPlayer then return false end
	if cfg.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then
		return false
	end
	return true
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function setIgnore(camera)
	local list = { camera }
	if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
	rayParams.FilterDescendantsInstances = list
end

local function canSee(camera, part, char)
	setIgnore(camera)
	local origin = camera.CFrame.Position
	local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(char)
end


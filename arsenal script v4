local activeSlider = nil

local function slider(page, text, key, min, max, decimals)
	local row = newRow(page, "Frame", 44)
	skinLabel(row, text, UDim2.new(1, -80, 0, 20), UDim2.fromOffset(12, 4), "font", 13, "text", Enum.TextXAlignment.Left)
	local valueLbl = skinLabel(row, "", UDim2.fromOffset(60, 20), UDim2.new(1, -72, 0, 4), "fontBold", 12, "sub", Enum.TextXAlignment.Right)

	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, -24, 0, 6)
	bar.Position = UDim2.new(0, 12, 0, 30)
	bar.BorderSizePixel = 0
	bar.AutoButtonColor = false
	bar.Text = ""
	bar.Parent = row
	skin(bar, "BackgroundColor3", "off")
	corner(bar, 3)
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.Parent = bar
	skin(fill, "BackgroundColor3", "accent")
	corner(fill, 3)

	local mult = 10 ^ decimals
	local function render()
		local v = cfg[key]
		fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
		valueLbl.Text = tostring(v)
	end
	local function setValue(v)
		cfg[key] = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		render()
	end
	render()
	table.insert(uiRepaint, render)

	local function fromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * alpha)
	end
	track(bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromX
			fromX(input.Position.X)
		end
	end))
end

local function cycle(page, text, key, options, onChange)
	local row = newRow(page, "TextButton", 32)
	row.AutoButtonColor = false
	row.Text = ""
	skinLabel(row, text, UDim2.new(0.5, 0, 1, 0), UDim2.fromOffset(12, 0), "font", 13, "text", Enum.TextXAlignment.Left)
	local valueLbl = skinLabel(row, tostring(cfg[key]), UDim2.new(0.5, -12, 1, 0), UDim2.new(0.5, 0, 0, 0), "fontBold", 12, "accent", Enum.TextXAlignment.Right)
	table.insert(uiRepaint, function() valueLbl.Text = tostring(cfg[key]) end)
	track(row.MouseButton1Click:Connect(function()
		local idx = table.find(options, cfg[key]) or 0
		idx = idx % #options + 1
		cfg[key] = options[idx]
		valueLbl.Text = options[idx]
		if onChange then onChange(options[idx]) end
	end))
	return valueLbl
end

local function button(page, text, kind, callback)
	local btn = newRow(page, "TextButton", 32)
	btn.AutoButtonColor = true
	btn.TextSize = 13
	btn.Text = text
	skin(btn, "Font", "fontBold")
	if kind == "accent" then

local function pairBones(list)
	local out = {}
	for _, p in ipairs(list) do
		table.insert(out, { p[1], Vector3.zero, p[2], Vector3.zero })
	end
	return out
end

local R15_BONES = pairBones({
	{ "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
})

local SKELETON_COLOR = Color3.new(1, 1, 1)

-- every player keeps a cache of the parts we read each frame, so the render loop
-- does table lookups instead of FindFirstChild calls
local function resolveBones(o)
	local char = o.char
	local defs = (o.hum and o.hum.RigType == Enum.HumanoidRigType.R15) and R15_BONES or R6_BONES
	o.defs = defs
	o.boneParts = {}
	local missing = false
	for i, def in ipairs(defs) do
		local a, b = char:FindFirstChild(def[1]), char:FindFirstChild(def[3])
		if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
			o.boneParts[i] = { a, b }
		else
			missing = true
		end
	end
	if missing then o.retryAt = os.clock() + 1 end
end

local function refreshCache(o, plr)
	local char = plr.Character
	if o.char == char and not (o.retryAt and os.clock() > o.retryAt) then return end
	o.char = char
	o.hum, o.root, o.head = nil, nil, nil
	o.boneParts = {}
	o.retryAt = nil
	if char then
		o.hum = char:FindFirstChildOfClass("Humanoid")
		o.root = char:FindFirstChild("HumanoidRootPart")
		o.head = char:FindFirstChild("Head")
		if o.hum and o.root and o.head then
			resolveBones(o)
		else
			o.retryAt = os.clock() + 0.5
		end
	end
end

local function buildOverlay(o)
	o.tracer = backend.newLine()
	o.arrow = backend.newArrow()
	o.bones = {}
end

local function destroyOverlay(o)
	if o.tracer then o.tracer.destroy() end
	if o.arrow then o.arrow.destroy() end
	for _, b in ipairs(o.bones or {}) do b.destroy() end
	o.tracer, o.arrow, o.bones = nil, nil, {}
end

local function addPlayer(plr)
	if plr == LocalPlayer or objects[plr] then return end

	local hl = Instance.new("Highlight")
	hl.FillColor = cfg.EnemyColor
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = false
	hl.Parent = gui

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 32)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Parent = gui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.Text = ""
	label.Parent = bb

	local o = { hl = hl, bb = bb, label = label, bones = {}, labelAt = 0, shown = false, boneParts = {} }
	objects[plr] = o
	if backend then buildOverlay(o) end
end

local function removePlayer(plr)
	local o = objects[plr]
	if not o then return end
	pcall(function() o.hl:Destroy() end)
	pcall(function() o.bb:Destroy() end)
	destroyOverlay(o)
	objects[plr] = nil
end


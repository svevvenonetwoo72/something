-- startup: ask which executor, or use the saved answer
------------------------------------------------------------------------
cfg.ModeShown = "compat"

local function finishStart(m)
	setMode(m)
	cfg.ModeShown = mode
	modeLabel.Text = mode
	main.Visible = true
	setStatus("mode: " .. mode .. ". insert esp | delete aim | end unload")
end

local function askExecutor()
	local detected = "unknown"
	pcall(function()
		if identifyexecutor then detected = tostring((identifyexecutor())) end
	end)
	local low = string.lower(detected)
	local suggestCompat = low:find("xeno") ~= nil or low:find("solara") ~= nil

	local prompt = Instance.new("Frame")
	prompt.Size = UDim2.fromOffset(320, 210)
	prompt.AnchorPoint = Vector2.new(0.5, 0.5)
	prompt.Position = UDim2.fromScale(0.5, 0.5)
	prompt.BackgroundColor3 = theme.bg
	prompt.BorderSizePixel = 0
	prompt.Active = true
	prompt.ZIndex = 50
	prompt.Parent = gui
	corner(prompt, 12)
	local ps = Instance.new("UIStroke")
	ps.Color = theme.off
	ps.Parent = prompt

	local t1 = label(prompt, "which executor are you using?", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 12),
		Enum.Font.GothamBold, 16, theme.text, Enum.TextXAlignment.Left)
	t1.ZIndex = 51
	local t2 = label(prompt, "detected: " .. detected, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 40),
		Enum.Font.Gotham, 12, theme.sub, Enum.TextXAlignment.Left)
	t2.ZIndex = 51

	local function choice(text, sub, y, isSuggested, m)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -24, 0, 56)
		b.Position = UDim2.fromOffset(12, y)
		b.BackgroundColor3 = isSuggested and theme.accent or theme.item
		b.BorderSizePixel = 0
		b.AutoButtonColor = true
		b.Text = ""
		b.ZIndex = 51
		b.Parent = prompt
		corner(b, 8)
		local a = label(b, text, UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 6), Enum.Font.GothamBold, 14,
			Color3.new(1, 1, 1), Enum.TextXAlignment.Left)
		a.ZIndex = 52
		local c = label(b, sub, UDim2.new(1, -20, 0, 18), UDim2.fromOffset(10, 30), Enum.Font.Gotham, 11,
			isSuggested and Color3.new(1, 1, 1) or theme.sub, Enum.TextXAlignment.Left)
		c.ZIndex = 52
		track(b.MouseButton1Click:Connect(function()
			prompt:Destroy()
			finishStart(m)
		end))
	end
	choice("xeno / solara", "compat: plain gui overlay, no hooks", 70, suggestCompat, "compat")
	choice("other (high unc)", "full: drawing overlay, better arrows, silent aim", 134, not suggestCompat and detected ~= "unknown", "full")
end

local function begin()
	if not gui.Parent then return end
	local saved = readMode()
	if saved then
		finishStart(saved)
	else
		askExecutor()
	end
end

if cfg.Intro then
	playIntro(begin)
else
	begin()
end

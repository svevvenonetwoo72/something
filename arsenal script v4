local function makeGuiBackend()
	local B = {}

	function B.newLine()
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.Visible = false
		f.Parent = overlay
		local o = {}
		function o.set(a, b, color, thick)
			local d = b - a
			f.Size = UDim2.fromOffset(d.Magnitude, thick)
			f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
			f.Rotation = math.deg(math.atan2(d.Y, d.X))
			f.BackgroundColor3 = color
			f.Visible = true
		end
		function o.hide() f.Visible = false end
		function o.destroy() pcall(function() f:Destroy() end) end
		return o
	end

	function B.newArrow()
		local c = Instance.new("Frame")
		c.Size = UDim2.fromOffset(30, 14)
		c.AnchorPoint = Vector2.new(0.5, 0.5)
		c.BackgroundTransparency = 1
		c.Visible = false
		c.Parent = overlay

		local bar = Instance.new("Frame")
		bar.Size = UDim2.fromOffset(18, 4)
		bar.Position = UDim2.new(0, 0, 0.5, -2)
		bar.BorderSizePixel = 0
		bar.Parent = c

		local head = Instance.new("Frame")
		head.Size = UDim2.fromOffset(10, 10)
		head.AnchorPoint = Vector2.new(0.5, 0.5)
		head.Position = UDim2.new(0, 22, 0.5, 0)
		head.Rotation = 45
		head.BorderSizePixel = 0
		head.Parent = c

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromOffset(50, 12)
		lbl.AnchorPoint = Vector2.new(0.5, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 11
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextStrokeTransparency = 0.4
		lbl.Visible = false
		lbl.Parent = overlay

		local o = {}
		function o.set(a)
			c.Position = UDim2.fromOffset(a.pos.X, a.pos.Y)
			c.Rotation = math.deg(math.atan2(a.dir.Y, a.dir.X))
			bar.BackgroundColor3 = a.color
			head.BackgroundColor3 = a.color
			c.Visible = true
			lbl.Position = UDim2.fromOffset(a.pos.X, a.pos.Y + 12)
			lbl.Text = a.text
			lbl.Visible = true
		end
		function o.hide()
			c.Visible = false
			lbl.Visible = false
		end
		function o.destroy()
			pcall(function() c:Destroy() end)
			pcall(function() lbl:Destroy() end)
		end
		return o
	end

	function B.newCircle()
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Visible = false
		f.Parent = overlay
		corner(f, 9999)
		local s = Instance.new("UIStroke")
		s.Thickness = 1
		s.Parent = f
		local o = {}
		function o.set(pos, radius, color)
			f.Position = UDim2.fromOffset(pos.X, pos.Y)
			f.Size = UDim2.fromOffset(radius * 2, radius * 2)
			s.Color = color
			f.Visible = true
		end
		function o.hide() f.Visible = false end
		function o.destroy() pcall(function() f:Destroy() end) end
		return o
	end

	return B
end

local function makeDrawBackend()
	local B = {}

	function B.newLine()
		local l = Drawing.new("Line")
		l.Visible = false
		l.Transparency = 1
		local o = {}
		function o.set(a, b, color, thick)
			l.From = a
			l.To = b
			l.Color = color
			l.Thickness = thick
			l.Visible = true
		end
		function o.hide() l.Visible = false end
		function o.destroy() pcall(function() l:Remove() end) end
		return o
	end

	-- filled triangle + black outline + distance text. size and fade come from the caller
	function B.newArrow()
		local fill = Drawing.new("Triangle")
		fill.Filled = true
		fill.Visible = false
		fill.Transparency = 1
		local outline = Drawing.new("Triangle")
		outline.Filled = false
		outline.Thickness = 1.5
		outline.Color = Color3.new(0, 0, 0)
		outline.Visible = false
		outline.Transparency = 1
		local txt = Drawing.new("Text")
		txt.Size = 13
		txt.Center = true
		txt.Outline = true
		txt.Color = Color3.new(1, 1, 1)
		txt.Visible = false
		txt.Transparency = 1

		local o = {}
		function o.set(a)
			local dir, size = a.dir, a.size
			local perp = Vector2.new(-dir.Y, dir.X)
			local tip = a.pos + dir * size
			local baseC = a.pos - dir * size * 0.35
			local left = baseC + perp * size * 0.75
			local right = baseC - perp * size * 0.75
			fill.PointA, fill.PointB, fill.PointC = tip, left, right
			outline.PointA, outline.PointB, outline.PointC = tip, left, right
			fill.Color = a.color
			fill.Transparency = a.alpha
			outline.Transparency = a.alpha
			txt.Transparency = a.alpha
			txt.Position = a.pos - dir * (size * 1.5) - Vector2.new(0, 6)
			txt.Text = a.text
			fill.Visible, outline.Visible, txt.Visible = true, true, true
		end
		function o.hide()
			fill.Visible, outline.Visible, txt.Visible = false, false, false
		end
		function o.destroy()
			pcall(function() fill:Remove() end)
			pcall(function() outline:Remove() end)
			pcall(function() txt:Remove() end)
		end
		return o
	end

	function B.newCircle()
		local c = Drawing.new("Circle")
		c.NumSides = 64
		c.Thickness = 1
		c.Filled = false
		c.Transparency = 1
		c.Visible = false
		local o = {}
		function o.set(pos, radius, color)
			c.Position = pos
			c.Radius = radius
			c.Color = color
			c.Visible = true
		end
		function o.hide() c.Visible = false end
		function o.destroy() pcall(function() c:Remove() end) end
		return o
	end

	return B
end


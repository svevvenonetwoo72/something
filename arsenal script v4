local function readText(path)
	if not hasFS then return nil end
	local ok, data = pcall(function()
		if isfile(path) then return readfile(path) end
	end)
	if ok and type(data) == "string" then return data end
	return nil
end

local function writeText(path, text)
	if not hasFS then return end
	pcall(makefolder, ROOT)
	pcall(writefile, path, text)
end

local themeName = "default"
do
	local saved = readText(ROOT .. "/theme.txt")
	if saved and THEMES[saved] then themeName = saved end
end
local theme = THEMES[themeName]
local themed = {}
local themeHooks = {}

local function skin(inst, prop, key)
	table.insert(themed, { inst, prop, key })
	inst[prop] = theme[key]
	return inst
end

local function applyTheme(name)
	if not THEMES[name] then return end
	themeName = name
	theme = THEMES[name]
	for i = #themed, 1, -1 do
		local t = themed[i]
		if t[1].Parent then
			t[1][t[2]] = theme[t[3]]
		else
			table.remove(themed, i)
		end
	end
	for _, f in ipairs(themeHooks) do pcall(f) end
	writeText(ROOT .. "/theme.txt", name)
end

-- config save and load (movement cheats and silent aim are never saved)
local DEFAULT_CFG = {}
for k, v in pairs(cfg) do DEFAULT_CFG[k] = v end
local NO_SAVE = { Speed = true, Fly = true, Noclip = true, InfJump = true, SilentAim = true, ModeShown = true }

local function saveConfig()
	if not hasFS then return false end
	local data = {}
	for k, v in pairs(cfg) do
		local t = typeof(v)
		if not NO_SAVE[k] and (t == "boolean" or t == "number" or t == "string") then data[k] = v end
	end
	writeText(ROOT .. "/config.json", HttpService:JSONEncode(data))
	return true
end

local function loadConfig()
	local text = readText(ROOT .. "/config.json")
	if not text then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(text) end)
	if not ok or type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		if cfg[k] ~= nil and not NO_SAVE[k] and typeof(cfg[k]) == typeof(v) then cfg[k] = v end
	end
	return true
end
loadConfig()

